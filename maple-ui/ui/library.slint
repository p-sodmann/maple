// Library browser page (Slint port of views/library/page.rs + grid.rs).
//
// The grid reproduces the former GTK `FlowBox`: a responsive wrap of fixed-size
// thumbnail tiles whose column count is derived from the available width. Tiles
// start as placeholders and are filled in-place as the Rust side decodes
// thumbnails on background threads (see src/grid.rs).
//
// The library is loaded a page at a time: both grid views report how many
// items the viewport is approaching (`request-more`, wired to
// `LibraryGrid::request_more`) and Rust appends the next page before the
// user reaches the end. Tiles themselves are still all instantiated —
// element-level virtualization is a later optimisation.
import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

// One grid cell. `image` is empty until `loaded` flips true.
export struct ThumbItem {
    id: int,
    image: image,
    name: string,
    loaded: bool,
    unsupported: bool,
    // Non-empty when this photo's bytes live on a device this one cannot ask
    // — the name of that device. Renders as a stated fact rather than as a
    // tile that failed to load, which is what it looked like before: a master
    // replicates a servant's metadata, holds none of its files, and has no
    // route to go and get them.
    held-on: string,
    stack-size: int,
    score: string,
    selected: bool,
}

// One day's worth of tiles within the date-grouped view: `start`/`count`
// index into the (day-sorted) `items` array owned by the parent view.
export struct DateGroup {
    label: string,
    start: int,
    count: int,
}

// A single thumbnail tile — shared by the flat grid and the date-grouped
// view so both stay visually identical. Callers position it via x/y.
component LibraryTile inherits Rectangle {
    in property <ThumbItem> item;
    in property <length> cell-size: 160px;
    callback clicked;

    property <length> label-h: 28px;
    width: root.cell-size;
    height: root.cell-size + root.label-h;

    VerticalLayout {
        spacing: 4px;

        frame := Rectangle {
            height: root.cell-size;
            border-radius: Theme.thumb-radius;
            clip: true;
            background: Theme.placeholder-bg;

            if root.item.loaded: Image {
                source: root.item.image;
                width: 100%;
                height: 100%;
                image-fit: cover;
            }

            if !root.item.loaded && !root.item.unsupported && root.item.held-on == "": Text {
                text: "…";
                color: Theme.dim-fg;
                font-size: 22px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            if !root.item.loaded && root.item.held-on != "": VerticalLayout {
                padding: 8px;
                spacing: 4px;
                alignment: center;
                Text {
                    text: "☁";
                    color: Theme.dim-fg;
                    font-size: 20px;
                    horizontal-alignment: center;
                }
                Text {
                    text: "held on\n" + root.item.held-on;
                    color: Theme.dim-fg;
                    font-size: 11px;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }

            if root.item.unsupported: Text {
                text: "Format not\nyet supported";
                color: Theme.dim-fg;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            // Hover ring.
            if ta.has-hover: Rectangle {
                border-radius: Theme.thumb-radius;
                border-width: 2px;
                border-color: Theme.accent;
            }

            // Selection ring + checkmark badge (select-mode).
            if root.item.selected: Rectangle {
                border-radius: Theme.thumb-radius;
                border-width: 3px;
                border-color: Theme.accent;
            }
            if root.item.selected: Rectangle {
                x: parent.width - 22px;
                y: 6px;
                width: 16px;
                height: 16px;
                border-radius: 8px;
                background: Theme.accent;
                Text {
                    text: "✓";
                    color: #FFFFFF;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            padding-left: 6px;
            padding-right: 6px;
            spacing: 4px;

            if root.item.stack-size >= 2: Text {
                text: "⊞ \{root.item.stack-size}";
                color: Theme.dim-fg;
                font-size: 11px;
                font-weight: 700;
                vertical-alignment: center;
            }

            Text {
                text: "#\{root.item.id}";
                color: Theme.dim-fg;
                font-size: 11px;
                vertical-alignment: center;
            }

            Text {
                text: root.item.score == "" ? root.item.name : root.item.name + "  ·  " + root.item.score;
                color: root.item.score == "" ? Theme.dim-fg : Theme.accent;
                font-size: 12px;
                overflow: elide;
                horizontal-alignment: right;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
        }
    }

    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Marquee/tap selection layer — stacked above a block of tiles, active only
// in select-mode. A drag paints a live rectangle preview; on release the
// gesture (tap vs. drag) and its rectangle are reported to Rust, which owns
// selection state and does the geometry-to-index translation. `columns` is
// reported alongside the rect because it depends on the live viewport width,
// which only Slint knows.
//
// `base`/`count` let one overlay serve either the whole flat grid (`base:
// -1`, `count: items.length`) or a single date-group's tile block (`base:
// group.start`, `count: group.count`) without the caller needing two
// implementations — Rust treats `base < 0` as "flat, subtract page padding".
component SelectOverlay inherits Rectangle {
    in property <bool> active: false;
    in property <int> base: -1;
    in property <int> count: 0;
    in property <float> columns: 1;
    callback released(int, int, length, length, length, length, float);

    property <length> x0: 0;
    property <length> y0: 0;
    property <length> x1: 0;
    property <length> y1: 0;
    property <bool> dragging: false;

    ta := TouchArea {
        visible: root.active;
        width: 100%;
        height: 100%;

        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.x0 = self.mouse-x;
                root.y0 = self.mouse-y;
                root.x1 = self.mouse-x;
                root.y1 = self.mouse-y;
                root.dragging = true;
            } else if e.kind == PointerEventKind.up {
                if root.dragging {
                    root.dragging = false;
                    root.released(root.base, root.count, root.x0, root.y0, root.x1, root.y1, root.columns);
                }
            }
        }

        moved => {
            root.x1 = self.mouse-x;
            root.y1 = self.mouse-y;
        }
    }

    if root.dragging: Rectangle {
        x: min(root.x0, root.x1);
        y: min(root.y0, root.y1);
        width: max(root.x0, root.x1) - min(root.x0, root.x1);
        height: max(root.y0, root.y1) - min(root.y0, root.y1);
        background: Theme.accent.with-alpha(0.12);
        border-width: 1.5px;
        border-color: Theme.accent;
        border-radius: 4px;
    }
}

export component LibraryGridView {
    in property <[ThumbItem]> items;
    in property <length> cell-size: 160px;
    in property <bool> select-mode: false;
    callback activated(int);
    callback select-drag(int, int, length, length, length, length, float);
    // Endless scrolling: "have at least this many items loaded".
    callback request-more(int);

    property <length> gap: Theme.gap;
    property <length> pad: Theme.pad;
    property <length> tile-h: root.cell-size + 28px;
    property <length> pitch-x: root.cell-size + root.gap;
    property <length> pitch-y: root.tile-h + root.gap;
    // Columns that fit the viewport (mirrors FlowBox's wrap behaviour).
    property <float> columns: Math.max(1, Math.floor((sv.visible-width - 2 * root.pad + root.gap) / (root.cell-size + root.gap)));
    property <float> row-count: Math.ceil(root.items.length / root.columns);

    // Items covered by the viewport plus a prefetch lead of one and a half
    // screens, so the next page is queried and decoded before the user
    // scrolls onto it. Deliberately a function of geometry alone and not of
    // `items.length`: appending a page must not feed straight back into
    // another request.
    property <length> prefetch-lead: 1.5 * sv.visible-height;
    property <int> want-count: Math.ceil((-sv.viewport-y + sv.visible-height + root.prefetch-lead) / root.pitch-y) * root.columns;
    changed want-count => {
        root.request-more(root.want-count);
    }

    sv := ScrollView {
        viewport-width: sv.visible-width;
        viewport-height: root.row-count * root.pitch-y + root.pad;

        for item[idx] in root.items: LibraryTile {
            property <float> grid-col: Math.mod(idx, root.columns);
            property <float> grid-row: Math.floor(idx / root.columns);
            x: root.pad + grid-col * root.pitch-x;
            y: root.pad + grid-row * root.pitch-y;
            cell-size: root.cell-size;
            item: item;
            clicked => {
                root.activated(idx);
            }
        }

        SelectOverlay {
            x: 0;
            y: 0;
            width: sv.viewport-width;
            height: sv.viewport-height;
            active: root.select-mode;
            base: -1;
            count: root.items.length;
            columns: root.columns;
            released(b, c, x0, y0, x1, y1, cols) => {
                root.select-drag(b, c, x0, y0, x1, y1, cols);
            }
        }
    }
}

// Same responsive flow grid as `LibraryGridView`, but broken into per-day
// blocks with a date-header divider. Relies on `items` being pre-sorted so
// each `DateGroup`'s `start..start+count` slice is contiguous.
export component LibraryDateGridView {
    in property <[ThumbItem]> items;
    in property <[DateGroup]> groups;
    in property <length> cell-size: 160px;
    in property <bool> select-mode: false;
    callback activated(int);
    callback select-drag(int, int, length, length, length, length, float);
    callback request-more(int);

    property <length> gap: Theme.gap;
    property <length> pad: Theme.pad;
    property <length> tile-h: root.cell-size + 28px;
    property <length> pitch-x: root.cell-size + root.gap;
    property <length> pitch-y: root.tile-h + root.gap;
    property <float> columns: Math.max(1, Math.floor((sv.visible-width - 2 * root.pad + root.gap) / (root.cell-size + root.gap)));

    // Same prefetch signal as the flat grid. Day headers and inter-group
    // spacing make a scrolled pixel worth slightly fewer tiles here, so this
    // over-estimates — which is the harmless direction: it asks for a page
    // slightly early, never late.
    property <length> prefetch-lead: 1.5 * sv.visible-height;
    property <int> want-count: Math.ceil((-sv.viewport-y + sv.visible-height + root.prefetch-lead) / root.pitch-y) * root.columns;
    changed want-count => {
        root.request-more(root.want-count);
    }

    sv := ScrollView {
        VerticalLayout {
            padding: root.pad;
            spacing: 22px;

            for group[gi] in root.groups: VerticalLayout {
                spacing: 10px;

                Text {
                    text: group.label;
                    color: Theme.ink;
                    font-size: 15px;
                    font-weight: 700;
                }

                Rectangle {
                    height: Math.ceil(group.count / root.columns) * root.pitch-y;

                    for j in group.count: LibraryTile {
                        x: Math.mod(j, root.columns) * root.pitch-x;
                        y: Math.floor(j / root.columns) * root.pitch-y;
                        cell-size: root.cell-size;
                        item: root.items[group.start + j];
                        clicked => {
                            root.activated(group.start + j);
                        }
                    }

                    // A marquee here cannot cross into the next day's block —
                    // each group gets its own overlay confined to its own
                    // Rectangle, matching the tiles' local coordinate space.
                    SelectOverlay {
                        x: 0;
                        y: 0;
                        width: 100%;
                        height: 100%;
                        active: root.select-mode;
                        base: group.start;
                        count: group.count;
                        columns: root.columns;
                        released(b, c, x0, y0, x1, y1, cols) => {
                            root.select-drag(b, c, x0, y0, x1, y1, cols);
                        }
                    }
                }
            }
        }
    }
}

export component LibraryPage inherits Rectangle {
    in property <[ThumbItem]> items;
    in property <[DateGroup]> date-groups;
    in property <bool> date-view: false;
    in property <length> cell-size: 160px;
    in property <bool> select-mode: false;
    callback search-changed(string);
    callback activated(int);
    callback select-drag(int, int, length, length, length, length, float);
    callback request-more(int);

    background: Theme.bg;

    VerticalLayout {
        // ── Grid ─────────────────────────────────────────────────
        if !root.date-view: LibraryGridView {
            vertical-stretch: 1;
            items: root.items;
            cell-size: root.cell-size;
            select-mode: root.select-mode;
            activated(i) => { root.activated(i); }
            select-drag(b, c, x0, y0, x1, y1, cols) => { root.select-drag(b, c, x0, y0, x1, y1, cols); }
            request-more(n) => { root.request-more(n); }
        }

        if root.date-view: LibraryDateGridView {
            vertical-stretch: 1;
            items: root.items;
            groups: root.date-groups;
            cell-size: root.cell-size;
            select-mode: root.select-mode;
            activated(i) => { root.activated(i); }
            select-drag(b, c, x0, y0, x1, y1, cols) => { root.select-drag(b, c, x0, y0, x1, y1, cols); }
            request-more(n) => { root.request-more(n); }
        }
    }
}
