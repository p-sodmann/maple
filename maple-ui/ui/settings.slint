// Settings window (Slint port of views/settings_window.rs).
//
// A separate top-level Window (thread_local singleton in src/settings_window.rs).

import { Theme } from "theme.slint";
import { FlatButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

// One key-value row in the settings display.
component SettingsRow {
    in property <string> label: "";
    in property <string> value: "";

    height: 34px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 12px;
        Text {
            text: root.label + ":";
            color: Theme.dim-fg;
            font-size: 12px;
            vertical-alignment: center;
            width: 170px;
        }
        Text {
            text: root.value;
            color: Theme.fg;
            font-size: 12px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
}

// Section heading.
component SectionHeading {
    in property <string> text: "";
    height: 28px;
    Text {
        text: root.text;
        color: Theme.accent;
        font-size: 12px;
        font-weight: 700;
        vertical-alignment: center;
        x: 8px;
    }
}

export component SettingsWindow inherits Window {
    title: "Maple — Settings";
    preferred-width: 560px;
    preferred-height: 480px;
    min-width: 400px;
    min-height: 300px;
    background: Theme.window-bg;
    default-font-size: 14px;

    in property <string> library-dir: "";
    in property <string> database-path: "";
    in property <string> cache-path: "";
    in property <string> thumbnail-quality: "80%";
    in property <string> ai-endpoint: "";
    in property <string> face-threshold: "";
    in-out property <string> status-text: "";

    // Confirmation modal state (for destructive debug actions).
    in-out property <bool> confirm-open: false;
    property <string> confirm-message: "";
    property <string> confirm-action-label: "Delete";

    callback close-requested;
    callback clear-ai-descriptions;
    callback clear-thumbnail-cache;
    // Fired only after the user confirms in the modal.
    callback delete-all-face-data;

    init => { key-scope.focus(); }

    key-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.confirm-open {
                    root.confirm-open = false;
                } else {
                    root.close-requested();
                }
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // Header
            Rectangle {
                height: 46px;
                background: Theme.sidebar-bg;
                HorizontalLayout {
                    padding: 8px;
                    spacing: 6px;
                    Text {
                        text: "Settings";
                        color: Theme.fg;
                        font-size: 16px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    FlatButton {
                        text: "✕ Close";
                        clicked => { root.close-requested(); }
                    }
                }
            }

            // Scrollable content
            ScrollView {
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 12px;
                    spacing: 2px;

                    SectionHeading { text: "Library"; }
                    SettingsRow { label: "Library folder";   value: root.library-dir; }
                    SettingsRow { label: "Database";          value: root.database-path; }
                    SettingsRow { label: "Cache folder";      value: root.cache-path; }

                    Rectangle { height: 12px; }
                    SectionHeading { text: "Thumbnails"; }
                    SettingsRow { label: "Quality";           value: root.thumbnail-quality; }

                    if root.ai-endpoint != "": Rectangle {
                        height: 12px;
                    }
                    if root.ai-endpoint != "": SectionHeading { text: "AI Tagging"; }
                    if root.ai-endpoint != "": SettingsRow {
                        label: "LM Studio endpoint";
                        value: root.ai-endpoint;
                    }

                    if root.face-threshold != "": Rectangle { height: 12px; }
                    if root.face-threshold != "": SectionHeading { text: "Face Recognition"; }
                    if root.face-threshold != "": SettingsRow {
                        label: "Similarity threshold";
                        value: root.face-threshold;
                    }

                    Rectangle { height: 16px; }
                    SectionHeading { text: "Actions"; }
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        FlatButton {
                            text: "Clear AI Descriptions";
                            clicked => { root.clear-ai-descriptions(); }
                        }
                        FlatButton {
                            text: "Clear Thumbnail Cache";
                            clicked => { root.clear-thumbnail-cache(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    Rectangle { height: 16px; }
                    SectionHeading { text: "Debug"; }
                    HorizontalLayout {
                        padding-left: 8px;
                        spacing: 8px;
                        FlatButton {
                            text: "Delete All Face Data";
                            clicked => {
                                root.confirm-message =
                                    "Permanently delete ALL detected faces and named people? "
                                    + "The face tagger will re-detect every image on its next pass. "
                                    + "This cannot be undone.";
                                root.confirm-action-label = "Delete Everything";
                                root.confirm-open = true;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }

                    if root.status-text != "": Text {
                        text: root.status-text;
                        color: Theme.accent;
                        font-size: 12px;
                        x: 8px;
                        height: 24px;
                    }
                }
            }
        }

        // ── Confirmation modal (stacked above the content) ────────
        if root.confirm-open: Rectangle {
            width: 100%;
            height: 100%;
            background: #000000bb;

            // Backdrop: swallow clicks so the content behind stays inert.
            TouchArea { }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 380px;
                height: dialog-layout.preferred-height;
                background: Theme.card-bg;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.sidebar-bg;

                dialog-layout := VerticalLayout {
                    padding: 18px;
                    spacing: 14px;

                    Text {
                        text: "Confirm";
                        color: Theme.fg;
                        font-size: 15px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.confirm-message;
                        color: Theme.dim-fg;
                        font-size: 13px;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Rectangle { horizontal-stretch: 1; }
                        FlatButton {
                            text: "Cancel";
                            clicked => { root.confirm-open = false; }
                        }
                        // Destructive confirm button.
                        Rectangle {
                            border-radius: 6px;
                            background: danger-ta.has-hover ? #c0392b : #e74c3c;
                            animate background { duration: 120ms; }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                padding-top: 6px;
                                padding-bottom: 6px;
                                Text {
                                    text: root.confirm-action-label;
                                    color: white;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                            danger-ta := TouchArea {
                                clicked => {
                                    root.confirm-open = false;
                                    root.delete-all-face-data();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
