// Import browser window + embedded ImportPage.
//
// ImportWindow: separate top-level Window (legacy browser phase).
// ImportPage:   Rectangle embedded in AppWindow's sidebar shell.

import { Theme } from "theme.slint";
import { FlatButton, PillButton, ProgressBar } from "widgets.slint";
import { ScrollView, LineEdit } from "std-widgets.slint";

// ── Exported structs ──────────────────────────────────────────────

// A source location shown in the ImportPage favourites / recents lists.
export struct ImportLocation {
    id:          string,
    name:        string,
    path:        string,
    count:       int,
    is-starred:  bool,
    is-selected: bool,
}

// A label the import brush can apply. Backed by a row in `collections` —
// Maple has one labelling system, and an import tag is a collection you
// happened to assign while triaging rather than afterwards.
export struct ImportTag {
    id: int,
    name: string,
    color: color,
    // Picker only: this tag is on the brush right now.
    chosen: bool,
}

// One photo of the session the tournament is currently running, for the
// strip under the two panes. The whole session is drawn, thrown-out
// photos included — seeing what was rejected is half of why it is there.
export struct TourneyCard {
    index: int,
    thumb: image,
    has-thumb: bool,
    filename: string,
    // 0 still in the running, 1 on screen left, 2 on screen right, 3 out.
    state: int,
}

export struct ImportItem {
    index: int,
    filename: string,
    thumb: image,
    // A decoded preview is in hand. Previews are decoded on demand around
    // the viewport, so this goes false again when one is evicted — it is
    // not "has been scanned".
    loaded: bool,
    is-selected: bool,   // marked for import — the yellow dot
    is-imported: bool,   // already present in the library
    // Moved past without being marked: a decision, not an absence. Set when
    // the user navigates away from a photo, and pre-set for photos an
    // earlier session already skipped.
    is-skipped: bool,
    // The scan produced no preview for this photo — it failed to decode, or
    // it ran past its time budget and the scan moved on without it. Still
    // listed, still selectable, still copied.
    is-unreadable: bool,
    // The display file (usually the JPEG of a RAW+JPEG pair) would not
    // decode and the preview came off the companion raw instead. The photo
    // is fine; the file beside it is not.
    from-companion: bool,
    // Decided in an *earlier* session (imported then, or skipped then).
    // What "Hide old images" filters on.
    is-old: bool,
    stack-size: int,     // >=2 when this photo belongs to a detected session
    has-jpg: bool,        // group has a non-raw (JPG/PNG) file
    has-raw: bool,        // group has a raw companion (or the display itself is raw)
    // Where this photo sits in its session. Both true at once is a session
    // of one. The `f` grid draws a band that opens at the start and closes
    // at the end, which is what makes a boundary visible as a *gap* rather
    // than as a line the eye has to hunt for.
    session-start: bool,
    session-end: bool,
    // Which session, counting from 0 in scan order; -1 when the scan
    // detected none. Identity, so the grid can highlight the one under the
    // cursor, and parity, so two sessions that meet are still two bands.
    session-id: int,
}

// ── Thumbnail grid (mirrors LibraryGridView) ──────────────────────

component ImportGridView {
    in property <[ImportItem]> items;
    in property <int> current-index: -1;    // highlighted (preview target)
    // Which row that photo sits in, or -1 while the filter is hiding it.
    // Separate from `current-index` because the index is the photo's stable
    // scan number and the row is where it happens to be *today* — hiding
    // old photos renumbers every row without moving a single photo.
    in property <int> current-row: -1;
    in property <length> cell-size: 120px;
    callback clicked(int);
    // Rows on screen (inclusive) plus the row the viewport is centred on.
    // Rust decodes these and lets go of what has been out of sight longest,
    // so this is what makes a few thousand photos affordable.
    callback window-changed(int, int, int);

    property <length> gap: Theme.gap;
    property <length> pad: Theme.pad;
    property <length> label-h: 22px;
    property <length> tile-h: root.cell-size + root.label-h;
    property <length> pitch-x: root.cell-size + root.gap;
    property <length> pitch-y: root.tile-h + root.gap;
    // 1 for the filmstrip down the side; the `f` grid sets it wider.
    in property <float> columns: 1;
    // Draw session bands and their boundaries. Off for the strip, where a
    // one-column list of bands would just be stripes.
    in property <bool> show-sessions: false;
    // The session under the cursor — the one a boundary edit acts on.
    in property <int> current-session: -1;
    property <float> row-count: Math.ceil(root.items.length / root.columns);

    // A margin either side of the viewport so a preview is usually already
    // decoded by the time it scrolls in. Deliberately a function of
    // geometry alone, like the library grid's prefetch lead.
    property <length> lead: 1.0 * sv.visible-height;
    property <int> first-wanted: Math.max(0, Math.floor((-sv.viewport-y - root.lead) / root.pitch-y));
    property <int> last-wanted: Math.max(0, Math.ceil((-sv.viewport-y + sv.visible-height + root.lead) / root.pitch-y));
    property <int> focus-row: Math.max(0, Math.floor((-sv.viewport-y + sv.visible-height / 2) / root.pitch-y));

    changed first-wanted => { root.window-changed(root.first-wanted, root.last-wanted, root.focus-row); }
    changed last-wanted => { root.window-changed(root.first-wanted, root.last-wanted, root.focus-row); }
    // The list itself changing (a scan filling in, the filter toggling)
    // changes what those rows *are*, so it has to re-ask too.
    //
    // Deliberately `row-count` and not `items`: a `changed` handler fires
    // when the property's value compares unequal, and `ModelRc`'s `==` is
    // pointer identity. Rust replaces the rows with `VecModel::set_vec`,
    // which mutates the model *behind* the same `ModelRc` — so `changed
    // items` compares equal and never fires at all. `row-count` reads
    // `items.length`, which tracks the model's own row-count notification.
    changed row-count => { root.window-changed(root.first-wanted, root.last-wanted, root.focus-row); }

    // How far down the strip the current photo is parked: 1 = second tile,
    // which keeps the photo you just came from on screen above it. Stepping
    // forward then scrolls by exactly one tile, so the strip moves at the
    // pace of the arrow key rather than jumping a screenful at a time.
    property <int> trail: 1;
    property <length> max-scroll: Math.max(0px, sv.viewport-height - sv.visible-height);

    // Following the *selection* is not the same as following the *scroll*.
    // This fires only when Rust moves the current photo — an arrow key, a
    // click, the filter landing somewhere new — and never when the viewport
    // moves, so dragging the strip by hand is left alone: scrolling ahead to
    // look at what is coming does not get yanked back.
    //
    // Both ends fall out of the clamp rather than needing a case: the first
    // photo has nothing to trail behind it, and near the end the strip is
    // already at the bottom, so the current photo simply walks down it.
    //
    // The row that is *scrolled to* is the grid row, not the strip row:
    // with `columns` tiles abreast, strip row 500 sits on grid row
    // 500/columns, and scrolling to 500 would overshoot by exactly that
    // factor — in practice straight to the bottom of the card. For the
    // one-column strip the two are the same number, which is why this went
    // unnoticed until the `f` grid asked for more than one column.
    property <int> current-grid-row:
        root.current-row >= 0 ? Math.floor(root.current-row / root.columns) : -1;

    function park() {
        if (root.current-grid-row >= 0) {
            sv.viewport-y = -Math.min(
                Math.max(root.pad + (root.current-grid-row - root.trail) * root.pitch-y, 0px),
                root.max-scroll);
        }
    }

    changed current-grid-row => { root.park(); }
    // `changed` does not fire for a value an element was *born* with, and
    // the `f` grid is created fresh every time it opens — so without this
    // it would open at the top however far down the card the cursor is.
    // Harmless if layout has not happened yet: `columns` is still 1 then,
    // and settles to its real value a moment later, which fires `changed`
    // and parks properly.
    init => { root.park(); }

    sv := ScrollView {
        viewport-width: sv.visible-width;
        viewport-height: root.row-count * root.pitch-y + root.pad;

        // `idx` is the *row*, and it shifts as soon as "Hide old images"
        // filters the strip; `item.index` is the photo's stable scan index
        // and is what Rust addresses everything by. Position comes from the
        // row, identity from the item.
        for item[idx] in root.items: Rectangle {
            property <float> grid-col: Math.mod(idx, root.columns);
            property <float> grid-row: Math.floor(idx / root.columns);
            x: root.pad + grid-col * root.pitch-x;
            y: root.pad + grid-row * root.pitch-y;
            width: root.cell-size;
            height: root.tile-h;
            // The session this photo belongs to, as a tinted plate behind
            // it. It runs into the gutter on the sides the session
            // continues through and stops short on the sides it ends,
            // which is what turns a boundary into a visible gap.
            property <bool> in-current-session:
                root.show-sessions && item.session-id >= 0
                && item.session-id == root.current-session;

            if root.show-sessions: Rectangle {
                x: item.session-start ? 0px : -root.gap / 2;
                width: root.cell-size
                    + (item.session-start ? 0px : root.gap / 2)
                    + (item.session-end ? 0px : root.gap / 2);
                y: -root.gap / 2;
                height: parent.height + root.gap;
                border-radius: 6px;
                background: parent.in-current-session
                    ? Theme.accent.with-alpha(0.20)
                    : (Math.mod(item.session-id, 2) == 0
                        ? Theme.fg.with-alpha(0.05)
                        : Theme.fg.with-alpha(0.11));
                border-width: parent.in-current-session ? 1px : 0px;
                border-color: Theme.accent;
            }

            VerticalLayout {
                spacing: 2px;

                frame := Rectangle {
                    height: root.cell-size;
                    border-radius: Theme.thumb-radius;
                    clip: true;
                    background: Theme.placeholder-bg;
                    border-width: item.index == root.current-index ? 2px : 0;
                    border-color: Theme.accent;

                    if item.loaded: Image {
                        source: item.thumb;
                        width: 100%;
                        height: 100%;
                        image-fit: cover;
                    }

                    if !item.loaded: Text {
                        text: "…";
                        color: Theme.dim-fg;
                        font-size: 18px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    // Scanned, but nothing came back. Say so rather than
                    // leaving an empty frame that looks like a tile still
                    // loading — the photo is copyable and the user needs to
                    // know it is there to decide about it.
                    // Small, bottom-left, out of the way of the verdict
                    // badge: this is information, not a decision.
                    if item.from-companion: Rectangle {
                        x: 4px;
                        y: parent.height - 20px;
                        width: 40px;
                        height: 16px;
                        border-radius: 8px;
                        background: #000000.with-alpha(0.55);
                        Text {
                            text: "RAW ⤴";
                            color: Theme.marked;
                            font-size: 9px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if item.loaded && item.is-unreadable: VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: "⚠";
                            color: Theme.rejected;
                            font-size: 16px;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "no preview";
                            color: Theme.dim-fg;
                            font-size: 9px;
                            horizontal-alignment: center;
                        }
                    }

                    if item.is-selected: Rectangle {
                        border-radius: Theme.thumb-radius;
                        background: Theme.accent.with-alpha(0.35);
                    }

                    if item.is-imported: Rectangle {
                        border-radius: Theme.thumb-radius;
                        background: #000000.with-alpha(0.45);
                        Text {
                            text: "✓";
                            color: white;
                            font-size: 22px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // One corner, one verdict — a yellow dot for "import
                    // it", a red × for "moved past it", nothing at all for
                    // one not looked at yet. Which of the three applies is
                    // settled in `make_item`, not here.
                    if item.is-selected: Rectangle {
                        x: parent.width - 20px;
                        y: 6px;
                        width: 12px;
                        height: 12px;
                        border-radius: 6px;
                        background: Theme.marked;
                        border-width: 1px;
                        border-color: #00000044;
                    }

                    if item.is-skipped: Rectangle {
                        x: parent.width - 22px;
                        y: 4px;
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        // A bare glyph vanishes into a busy photo; the
                        // scrim is what makes the verdict readable while
                        // scrubbing the strip.
                        background: #000000.with-alpha(0.55);
                        Text {
                            // U+00D7 — see the note on the tag chip.
                            text: "×";
                            color: Theme.rejected;
                            font-size: 12px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if item.stack-size >= 2: Rectangle {
                        x: 4px;
                        y: 4px;
                        width: 34px;
                        height: 18px;
                        border-radius: 9px;
                        background: #000000.with-alpha(0.55);
                        Text {
                            text: "⊞ \{item.stack-size}";
                            color: white;
                            font-size: 11px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if ta.has-hover: Rectangle {
                        border-radius: Theme.thumb-radius;
                        border-width: 2px;
                        border-color: Theme.accent.with-alpha(0.7);
                    }
                }

                HorizontalLayout {
                    height: root.label-h;
                    spacing: 6px;

                    if item.filename != "": Text {
                        text: "JPG";
                        font-size: 9px;
                        font-weight: 700;
                        letter-spacing: 0.4px;
                        vertical-alignment: center;
                        color: item.has-jpg ? Theme.fg : Theme.dim-fg.with-alpha(0.4);
                    }
                    if item.filename != "": Text {
                        text: "RAW";
                        font-size: 9px;
                        font-weight: 700;
                        letter-spacing: 0.4px;
                        vertical-alignment: center;
                        color: item.has-raw ? Theme.fg : Theme.dim-fg.with-alpha(0.4);
                    }

                    Text {
                        text: item.filename;
                        color: Theme.dim-fg;
                        font-size: 11px;
                        overflow: elide;
                        horizontal-stretch: 1;
                        horizontal-alignment: right;
                    }
                }
            }

            ta := TouchArea {
                clicked => { root.clicked(item.index); }
            }
        }
    }
}

// ── Copy-mode dropdown ─────────────────────────────────────────────
//
// Picks what gets copied for each selected group: display file only
// ("JPG"), display + raw companion ("JPG + RAW"), or raw only ("RAW").
// Mirrors `maple_import::CopyMode` — indices line up with `DisplayOnly`
// (0), `All` (1), `RawOnly` (2).

component CopyModeDropdown inherits Rectangle {
    in property <int> mode: 1;
    callback mode-changed(int);

    property <[string]> labels: ["JPG", "JPG + RAW", "RAW"];

    width: 108px;
    height: 30px;
    border-radius: Theme.radius-btn;
    background: dd-ta.has-hover ? Theme.card-bg-hover : Theme.card-bg;
    border-width: 1px;
    border-color: Theme.separator-color;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 4px;

        Text {
            text: root.labels[root.mode];
            color: Theme.fg;
            font-size: 12px;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: popup.is-open ? "▴" : "▾";
            color: Theme.dim-fg;
            font-size: 10px;
            vertical-alignment: center;
        }
    }

    dd-ta := TouchArea {
        clicked => { popup.show(); }
    }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;

        Rectangle {
            border-radius: Theme.radius-btn;
            background: Theme.card-bg;
            border-width: 1px;
            border-color: Theme.separator-color;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000033;

            VerticalLayout {
                padding: 4px;
                spacing: 2px;

                for label[i] in root.labels: Rectangle {
                    height: 28px;
                    border-radius: 6px;
                    background: opt-ta.has-hover ? Theme.card-bg-hover : transparent;
                    animate background { duration: 80ms; }

                    Text {
                        text: label;
                        color: i == root.mode ? Theme.accent : Theme.fg;
                        font-size: 12px;
                        font-weight: i == root.mode ? 700 : 500;
                        vertical-alignment: center;
                        x: 10px;
                    }

                    opt-ta := TouchArea {
                        clicked => {
                            root.mode-changed(i);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

// ── Main import window ────────────────────────────────────────────

// A mode switch for the header.
//
// Deliberately not another pill beside "Hide old images": that one filters
// what you are looking at, while this one changes what the window *is* —
// the strip and the big preview go away and the whole content area becomes
// a comparison. A control that reads as a different kind of thing is worth
// the twenty lines.
component ToggleSwitch inherits Rectangle {
    in property <bool> checked;
    in property <string> text;
    callback toggled();

    height: 24px;
    width: 38px + lbl.preferred-width;

    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: 30px;
        height: 17px;
        border-radius: 8px;
        background: root.checked ? Theme.accent : Theme.placeholder-bg;
        animate background { duration: 120ms; }

        Rectangle {
            y: 2px;
            x: root.checked ? parent.width - self.width - 2px : 2px;
            width: 13px;
            height: 13px;
            border-radius: 6px;
            background: root.checked ? Theme.accent-fg : Theme.dim-fg;
            animate x { duration: 120ms; easing: ease-out; }
        }
    }

    lbl := Text {
        x: 38px;
        height: 100%;
        text: root.text;
        color: root.checked ? Theme.accent-text : Theme.dim-fg;
        font-size: 12px;
        font-weight: root.checked ? 700 : 500;
        vertical-alignment: center;
    }

    TouchArea {
        clicked => { root.toggled(); }
    }
}

// The session under the two panes: what has been thrown out, what is
// still in the running, and which two are on screen.
//
// A bracket only ever shows two photos at a time, which leaves the user
// with no idea how far through a session of twenty they are or what they
// have already rejected. This is that context, and it costs one strip.
component TourneyStrip inherits Rectangle {
    in property <[TourneyCard]> cards;

    property <length> card-w: 74px;
    property <length> pitch: 80px;

    background: Theme.sidebar-bg;

    ScrollView {
        viewport-width: Math.max(self.visible-width, root.cards.length * root.pitch + 16px);
        viewport-height: self.visible-height;

        for c[i] in root.cards: Rectangle {
            x: 8px + i * root.pitch;
            y: 6px;
            width: root.card-w;
            height: parent.height - 12px;
            border-radius: 6px;
            border-width: c.state == 1 || c.state == 2 ? 2px : 1px;
            border-color: c.state == 1 || c.state == 2
                ? Theme.accent
                : (c.state == 3 ? transparent : Theme.separator-color);
            background: Theme.photo-surface;
            clip: true;

            if c.has-thumb: Image {
                source: c.thumb;
                image-fit: contain;
                width: 100%;
                height: 100%;
                // Out of the running: still shown, plainly not in it.
                opacity: c.state == 3 ? 0.22 : 1.0;
            }

            // Which pane this photo is in, said in the same characters as
            // the keys that decide it.
            if c.state == 1 || c.state == 2: Rectangle {
                x: 3px;
                y: 3px;
                width: 16px;
                height: 16px;
                border-radius: 4px;
                background: Theme.accent;
                Text {
                    text: c.state == 1 ? "L" : "R";
                    color: Theme.accent-fg;
                    font-size: 10px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if c.state == 3: Text {
                text: "✕";
                color: Theme.rejected;
                font-size: 20px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

// Drags, scrolls and the pixel size of the thing being looked at, all
// reported *up* rather than acted on here.
//
// One surface, two users: a tournament pane and the single-photo preview.
// They ask the same question — is this frame sharp — at different arity,
// and the zoom for both lives in Rust, so the only thing either view needs
// from the pointer is where it went and how big the picture may be drawn.
//
// The size goes up through derived `int` properties rather than `changed
// width` for the same reason `ImportGridView` watches `row-count`: a
// `changed` handler is only as reliable as the property it is hung on, and
// this one decides whether anything is drawn at all. `init` reports too,
// because Slint does not fire `changed` for the value an element was born
// with.
component ZoomSurface inherits TouchArea {
    // Drag by this many pane pixels; scroll by this many notches at this
    // point of the surface (0..1 on each axis).
    callback pan(length, length);
    callback zoom-at(float, float, float);
    callback resized(int, int);

    // Both users put this over a plain Rectangle and mean "all of it".
    // Said explicitly rather than left to the default, because the size
    // reported below is the size everything is rendered to: a surface that
    // came out 0x0 would not just miss clicks, it would make the view fall
    // back to guessing its own dimensions from the window.
    width: 100%;
    height: 100%;

    property <int> px-w: self.width / 1px;
    property <int> px-h: self.height / 1px;
    changed px-w => { root.resized(root.px-w, root.px-h); }
    changed px-h => { root.resized(root.px-w, root.px-h); }
    init => { root.resized(root.px-w, root.px-h); }

    // Where the pointer was when the drag last reported, so `moved` can
    // hand up a delta. `pressed-x` would give the distance from the press
    // instead, which double-counts once the centre moves.
    property <length> last-x;
    property <length> last-y;
    mouse-cursor: MouseCursor.grab;

    pointer-event(e) => {
        if (e.kind == PointerEventKind.down) {
            self.last-x = self.mouse-x;
            self.last-y = self.mouse-y;
        }
    }
    moved => {
        root.pan(self.mouse-x - self.last-x, self.mouse-y - self.last-y);
        self.last-x = self.mouse-x;
        self.last-y = self.mouse-y;
    }
    scroll-event(e) => {
        root.zoom-at(
            e.delta-y / 1px,
            self.mouse-x / Math.max(1px, self.width),
            self.mouse-y / Math.max(1px, self.height));
        return accept;
    }
}

// One contestant in the tournament.
//
// Pan and zoom are reported *up* rather than applied here, which is the
// whole of what makes the zoom paired: there is one zoom level and one
// centre, they live in Rust, and both panes are drawn from them. A pane
// that kept its own would have to be told to follow the other one, and the
// two would drift the first time a render was dropped.
component TourneyPane inherits Rectangle {
    in property <image> photo;
    in property <string> name;
    in property <string> meta;
    in property <string> hint;
    in property <bool> has-photo: true;

    // Straight through from the surface below: the pane holds no view
    // state of its own.
    callback pan(length, length);
    callback zoom-at(float, float, float);
    callback resized(int, int);

    background: Theme.photo-surface;
    clip: true;

    VerticalLayout {
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            if root.has-photo: Image {
                source: root.photo;
                image-fit: contain;
                width: 100%;
                height: 100%;
            }
            if !root.has-photo: Text {
                text: "no preview";
                color: Theme.dim-fg;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        Rectangle {
            height: 30px;
            background: Theme.sidebar-bg;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;

                Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 20px;
                    height: 20px;
                    border-radius: 5px;
                    background: Theme.accent-tint;
                    Text {
                        text: root.hint;
                        color: Theme.accent-text;
                        font-size: 12px;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.name;
                    color: Theme.fg;
                    font-size: 12px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                Text {
                    text: root.meta;
                    color: Theme.dim-fg;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }
    }

    ZoomSurface {
        pan(dx, dy) => { root.pan(dx, dy); }
        zoom-at(d, fx, fy) => { root.zoom-at(d, fx, fy); }
        resized(w, h) => { root.resized(w, h); }
    }
}

export component ImportWindow inherits Window {
    title: "Maple — Import";
    preferred-width: 960px;
    preferred-height: 680px;
    min-width: 600px;
    min-height: 400px;
    background: Theme.window-bg;
    default-font-size: 14px;

    in-out property <bool> dark <=> Theme.dark;

    in-out property <bool> in-browser: false;

    // Picker state
    in property <string> source-path: "";
    in property <string> dest-path: "";

    // Browser state
    in property <[ImportItem]> items;
    in-out property <int> current-index: 0;
    // The strip row `current-index` occupies; -1 when it is filtered out.
    // Rust sets it alongside `current-index` and the strip scrolls to it.
    in property <int> current-row: -1;
    in property <image> preview-photo;
    in property <bool> preview-loading: false;
    in property <string> preview-filename: "";
    // How far into the single photo the view is, 1.0 being "fits the
    // pane". Above that `preview-photo` is a crop off the original decode
    // rendered to exactly this view's pixel size, not a magnified preview
    // — the same arrangement the two tournament panes use, because it is
    // the same judgement being made about one photo instead of two.
    in property <float> preview-zoom-level: 1.0;
    in property <int> selected-count: 0;
    in property <int> total-count: 0;
    // How many of the scanned photos an earlier session already decided on.
    // The "Hide old images" toggle only appears once there is something to
    // hide.
    in property <int> old-count: 0;
    in-out property <bool> hide-old: true;
    // The `f` grid: every photo at once, with session bands. While it is
    // open "Hide old images" stands down — Rust suspends the filter rather
    // than the grid working around it, because a band drawn over a sequence
    // with photos missing from the middle would lie about what it holds.
    in-out property <bool> grid-open: false;
    // The photo a grid click opened a session on, waiting for the click
    // that closes it. -1 when no edit is half-finished.
    in property <int> pending-session-start: -1;
    // Sessions worth the name — two photos or more. Half the sessions on a
    // real card are solo, so the raw count alone reads as noise.
    in property <int> group-count: 0;
    // ── The tournament ────────────────────────────────────────────
    //
    // A vs B, and the user says which survives. Nothing is preselected any
    // more, so this is where a session's keeper is actually chosen.
    in-out property <bool> tourney-on: false;
    // Only offered once there is something to compare — a scan that found
    // no group of two has no tournament to run.
    in property <bool> tourney-available: false;
    // Whether a comparison is on screen *right now*. Not a mode the user
    // switches into: it follows the cursor, so a photo in a session gets
    // the two panes and a photo in none gets the ordinary single view,
    // along one walk through the card.
    in property <bool> tourney-active: false;
    in property <image> tourney-left;
    in property <image> tourney-right;
    in property <bool> tourney-left-shown: false;
    in property <bool> tourney-right-shown: false;
    in property <string> tourney-left-name: "";
    in property <string> tourney-right-name: "";
    in property <string> tourney-left-meta: "";
    in property <string> tourney-right-meta: "";
    // The session on screen: every photo of it, with what each is doing.
    in property <[TourneyCard]> tourney-group;
    // How many of that session are still in the running, and which round
    // of it is being played.
    in property <int> tourney-alive: 0;
    in property <int> tourney-session-round: 0;
    // Photos decided out of photos covered, and which session of how many.
    in property <int> tourney-done: 0;
    in property <int> tourney-total: 0;
    in property <int> tourney-round: 0;
    in property <int> tourney-rounds: 0;
    // 1.0 is "fits the pane"; above that the panes are showing a crop of
    // the original decode, not a magnified preview.
    in property <float> tourney-zoom-level: 1.0;
    // Whether the last verdict can still be taken back. Every keystroke
    // here decides a photo for good and `1` and `2` are one key apart, so
    // the way out has to be visible rather than folklore.
    in property <bool> tourney-can-undo: false;

    // Which session the current photo sits in, so the grid can pick it out
    // of the bands. -1 when nothing was detected.
    in property <int> current-session: -1;
    // How many sessions the scan found, for the grid's own status line.
    in property <int> session-count: 0;
    // The brush: the tags every photo marked from here on will carry. Shown
    // in the floating panel so it is legible while triaging, because it
    // changes *within* a pass rather than being set once per import.
    in property <[ImportTag]> tags;
    // Every tag in the library, `chosen` set for the ones on the brush.
    // Only populated while the picker is open.
    in property <[ImportTag]> tag-choices;
    in-out property <bool> tag-picker-open: false;

    // Verdict on the photo in the big preview: 0 undecided, 1 marked for
    // import, 2 moved past, 3 already in the library. Mirrors the badge on
    // its tile, where the user is not necessarily looking.
    in property <int> preview-state: 0;
    in property <string> status-text: "Pick a source folder to begin.";
    // Live scan progress — while true the status bar shows a progress bar
    // (scanned-count / total-count) instead of status-text.
    in property <bool> scanning: false;
    in property <int> scanned-count: 0;
    in property <bool> copying: false;
    in property <bool> copy-done: false;
    in property <bool> rotating: false;
    // What to copy for each selected group — mirrors `maple_import::CopyMode`:
    // 0 = display only ("JPG"), 1 = display + raw ("JPG + RAW"), 2 = raw only ("RAW").
    in-out property <int> copy-mode: 1;

    callback close-requested;
    callback pick-source;
    callback pick-dest;
    callback open-path-template;
    callback start-scan;
    callback item-clicked(int);
    // Rows on screen (inclusive) and the row at its centre.
    callback preview-window(int, int, int);
    // The single-photo view's own pan, zoom and pixel size. Same three
    // signals as the tournament's, and the same reason they leave the
    // markup: the crop is cut in Rust at exactly the size reported here,
    // so a zoomed pixel is never a resampled resample.
    callback preview-pan(length, length);
    callback preview-zoom(float, float, float);
    callback preview-view(int, int);
    callback preview-reset-zoom();
    callback toggle-hide-old();
    // Show or hide the `f` grid.
    callback toggle-grid();
    // Toggle the session boundary immediately before / after this photo.
    // One operation: where there is no boundary it splits, where there is
    // one it merges, so "set the start here" and "set the stop here" are
    // the same key one photo apart.
    callback cut-before(int);
    callback cut-after(int);
    // A click inside the `f` grid: the first opens a session on that photo,
    // the next closes it there.
    callback grid-clicked(int);
    // Turn the A-vs-B pass on or off. Off keeps every verdict already
    // given — turning it back on resumes rather than restarting.
    callback toggle-tournament();
    // 1 = keep left, 2 = keep right, 3 = keep both.
    callback tourney-verdict(int);
    callback tourney-undo();
    // End this session here and keep whoever is still standing.
    callback tourney-keep-rest();
    // The pane's size in pixels — Rust renders the crop at exactly this
    // size, so it has to be told when the window changes shape.
    callback tourney-view(int, int);
    callback tourney-pan(length, length);
    // Scroll notches, and where in the pane (0..1) they happened, so the
    // zoom goes towards what the pointer is over.
    callback tourney-zoom(float, float, float);
    callback tourney-reset-zoom();
    callback copy-selected;
    callback nav-prev;
    callback nav-next;
    // rotate(clockwise): true = 90° CW, false = 90° CCW.
    callback rotate(bool);
    callback open-tag-picker;
    callback close-tag-picker;
    // Add or remove one tag from the brush, by collection id.
    callback tag-toggled(int);
    // Create a tag by name and put it on the brush. An existing name is
    // adopted rather than rejected — `collections.name` is UNIQUE.
    callback tag-created(string);
    callback clear-tags;
    // Hand the keyboard back to the triage scope. The picker's name field
    // takes focus while it is open, and nothing returns it on close — the
    // hotkeys would stay dead until the user clicked somewhere.
    callback refocus-keys;

    init => { key-scope.focus(); }
    refocus-keys => { key-scope.focus(); }

    key-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == Key.Escape {
                // The picker is the innermost thing open, so it swallows the
                // first Escape — closing the whole window out from under a
                // half-typed tag name would be the wrong reading.
                if root.tag-picker-open {
                    root.close-tag-picker();
                    return accept;
                }
                // Innermost first: the grid is a mode the user is in, and
                // closing the whole window out from under it would be the
                // wrong reading of "get me out of this".
                if root.grid-open {
                    root.toggle-grid();
                    return accept;
                }
                root.close-requested();
                return accept;
            }
            // While the picker is open every letter belongs to its name
            // field, so the triage hotkeys stand down rather than firing
            // behind it.
            if root.in-browser && !root.tag-picker-open {
                // The tournament is a mode, and its keys come first: while
                // it is up there is no filmstrip to step along and no
                // "current photo" for `x` to mark, so letting those keys
                // fire behind it would silently mark whatever the strip
                // had been left on.
                if root.tourney-active {
                    if event.text == "1" { root.tourney-verdict(1); return accept; }
                    if event.text == "2" { root.tourney-verdict(2); return accept; }
                    if event.text == "3" { root.tourney-verdict(3); return accept; }
                    if event.text == "u" || event.text == "U" {
                        root.tourney-undo();
                        return accept;
                    }
                    if event.text == "k" || event.text == "K" {
                        root.tourney-keep-rest();
                        return accept;
                    }
                    if event.text == "0" { root.tourney-reset-zoom(); return accept; }
                    if event.text == "+" || event.text == "=" {
                        root.tourney-zoom(3, 0.5, 0.5);
                        return accept;
                    }
                    if event.text == "-" || event.text == "_" {
                        root.tourney-zoom(-3, 0.5, 0.5);
                        return accept;
                    }
                }
                // The same three keys over one photo. A comparison and a
                // single photo are the same question at different arity,
                // so the zoom must not disappear when the cursor walks out
                // of a session — which is exactly what it did while the
                // only zoom in the window belonged to the panes.
                if !root.tourney-active && !root.grid-open {
                    if event.text == "0" { root.preview-reset-zoom(); return accept; }
                    if event.text == "+" || event.text == "=" {
                        root.preview-zoom(3, 0.5, 0.5);
                        return accept;
                    }
                    if event.text == "-" || event.text == "_" {
                        root.preview-zoom(-3, 0.5, 0.5);
                        return accept;
                    }
                }
                // Arrows still navigate during a comparison — Rust steps
                // over the whole session rather than photo by photo inside
                // it, which is the only way past a session the user does
                // not want to judge right now.
                if event.text == Key.LeftArrow || event.text == Key.UpArrow {
                    root.nav-prev();
                    return accept;
                }
                if event.text == Key.RightArrow || event.text == Key.DownArrow {
                    root.nav-next();
                    return accept;
                }
                if event.text == "x" || event.text == "X" {
                    if root.tourney-active { return accept; }
                    root.item-clicked(root.current-index);
                    return accept;
                }
                if event.text == "s" || event.text == "S" {
                    root.open-tag-picker();
                    return accept;
                }
                if event.text == "f" || event.text == "F" {
                    root.toggle-grid();
                    return accept;
                }
                // Boundary editing only means something where the bands
                // are drawn, so these stay dead outside the grid rather
                // than silently regrouping a card the user cannot see.
                if root.grid-open {
                    if event.text == "[" {
                        root.cut-before(root.current-index);
                        return accept;
                    }
                    if event.text == "]" {
                        root.cut-after(root.current-index);
                        return accept;
                    }
                }
                if event.text == "c" || event.text == "C" {
                    root.clear-tags();
                    return accept;
                }
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;

            Rectangle {
                height: 46px;
                background: Theme.sidebar-bg;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 6px;

                    FlatButton {
                        text: "← Back";
                        clicked => { root.close-requested(); }
                    }

                    Text {
                        text: root.in-browser ? "Import Photos" : "Choose Folders";
                        color: Theme.fg;
                        font-size: 16px;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    if root.in-browser && root.old-count > 0: Rectangle {
                        border-radius: Theme.radius-btn;
                        background: root.hide-old
                            ? Theme.accent-tint
                            : (old-ta.has-hover ? Theme.card-bg : transparent);
                        border-width: 1px;
                        border-color: root.hide-old ? Theme.accent : transparent;
                        animate background { duration: 120ms; }

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text {
                                text: root.hide-old
                                    ? "\{root.old-count} old hidden"
                                    : "Hide old images";
                                color: root.hide-old ? Theme.accent-text : Theme.dim-fg;
                                font-size: 12px;
                                font-weight: root.hide-old ? 700 : 500;
                                vertical-alignment: center;
                            }
                        }

                        old-ta := TouchArea {
                            clicked => { root.toggle-hide-old(); }
                        }
                    }

                    if root.in-browser && root.tourney-available: ToggleSwitch {
                        y: (parent.height - self.height) / 2;
                        text: "Tournament";
                        checked: root.tourney-on;
                        toggled => { root.toggle-tournament(); }
                    }

                    if root.in-browser: Text {
                        text: root.selected-count > 0
                            ? "\{root.selected-count} selected"
                            : "\{root.total-count} photos";
                        color: Theme.dim-fg;
                        font-size: 13px;
                        vertical-alignment: center;
                    }

                    if root.in-browser: CopyModeDropdown {
                        mode: root.copy-mode;
                        mode-changed(i) => { root.copy-mode = i; }
                    }

                    if root.in-browser: Rectangle {
                        border-radius: Theme.radius-btn;
                        background: root.copy-done
                            ? Theme.success
                            : (root.selected-count > 0 && !root.copying
                                ? (copy-ta.has-hover ? Theme.accent.darker(0.12) : Theme.accent)
                                : Theme.placeholder-bg);
                        animate background { duration: 120ms; }

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            Text {
                                text: root.copy-done
                                    ? "Copying done"
                                    : (root.copying ? "Copying…" : "Copy Selected");
                                color: root.copy-done || (root.selected-count > 0 && !root.copying)
                                    ? Theme.accent-fg
                                    : Theme.dim-fg;
                                font-size: 13px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }

                        copy-ta := TouchArea {
                            enabled: root.selected-count > 0 && !root.copying;
                            clicked => { root.copy-selected(); }
                        }
                    }
                }
            }

            if !root.in-browser: VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 20px;
                padding-left: 60px;
                padding-right: 60px;

                Text {
                    text: "Source folder";
                    color: Theme.dim-fg;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    FlatButton {
                        text: root.source-path == "" ? "Choose Source…" : root.source-path;
                        clicked => { root.pick-source(); }
                    }
                }

                Text {
                    text: "Destination folder";
                    color: Theme.dim-fg;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    FlatButton {
                        text: root.dest-path == "" ? "Choose Destination…" : root.dest-path;
                        clicked => { root.pick-dest(); }
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    FlatButton {
                        text: "Configure file naming…";
                        clicked => { root.open-path-template(); }
                    }
                }

                HorizontalLayout {
                    alignment: center;
                    PillButton {
                        width: 220px;
                        text: "Start Scan";
                        primary: true;
                        enabled: root.source-path != "" && root.dest-path != "";
                        clicked => { root.start-scan(); }
                    }
                }

                if root.status-text != "": Text {
                    text: root.status-text;
                    color: Theme.dim-fg;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }

            // The `f` grid — every photo at once, sessions drawn as bands.
            // It takes the whole content area rather than sitting beside
            // the preview: the thing it is for is seeing where one sitting
            // of shooting ends and the next begins, and that needs room.
            if root.in-browser && root.grid-open: VerticalLayout {
                vertical-stretch: 1;

                grid := ImportGridView {
                    vertical-stretch: 1;
                    items: root.items;
                    current-index: root.current-index;
                    current-row: root.current-row;
                    cell-size: 132px;
                    show-sessions: true;
                    current-session: root.current-session;
                    // Whole tiles only — a trailing half-tile would put a
                    // session boundary half off the edge.
                    columns: Math.max(1, Math.floor(self.width / 148px));
                    clicked(i) => { root.grid-clicked(i); }
                    window-changed(a, b, c) => { root.preview-window(a, b, c); }
                }

                Rectangle {
                    height: 30px;
                    background: Theme.card-bg;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;
                        Text {
                            // Sessions are segmented once, when the scan
                            // finishes — so mid-scan there are none *yet*,
                            // which is not the same as none being found.
                            // Saying "no sessions detected" through the
                            // whole of a long card is a lie about the one
                            // thing this view exists to show.
                            text: root.scanning
                                ? "scanning — sessions are found when it finishes"
                                : (root.session-count > 0
                                    ? "\{root.group-count} groups in \{root.session-count} sessions"
                                    : "no sessions detected");
                            color: Theme.dim-fg;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.pending-session-start >= 0
                                ? "session open at #\{root.pending-session-start} — click its last photo to close it"
                                : "click  open a session, click again to close it      [  ]  start / stop      f  back";
                            color: Theme.dim-fg;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }

            // The tournament: two photos, one question.
            //
            // It takes the whole content area for the same reason the `f`
            // grid does — the judgement being asked for is "is this one
            // sharper", and that needs both frames as big as the window
            // can make them. There is no filmstrip beside it because there
            // is nothing to navigate: the pass decides the order.
            if root.in-browser && !root.grid-open && root.tourney-active: VerticalLayout {
                vertical-stretch: 1;

                HorizontalLayout {
                    vertical-stretch: 1;
                    spacing: 2px;

                    TourneyPane {
                        horizontal-stretch: 1;
                        hint: "1";
                        photo: root.tourney-left;
                        has-photo: root.tourney-left-shown;
                        name: root.tourney-left-name;
                        meta: root.tourney-left-meta;
                        pan(dx, dy) => { root.tourney-pan(dx, dy); }
                        zoom-at(d, fx, fy) => { root.tourney-zoom(d, fx, fy); }
                        // Both panes are the same size, so one of them
                        // reporting is enough — and Rust renders the crop
                        // at exactly this size rather than letting Slint
                        // scale it, or a zoomed pixel would be a resampled
                        // resample.
                        resized(pw, ph) => { root.tourney-view(pw, ph); }
                        init => { root.tourney-view(self.width / 1px, self.height / 1px); }
                    }

                    TourneyPane {
                        horizontal-stretch: 1;
                        hint: "2";
                        photo: root.tourney-right;
                        has-photo: root.tourney-right-shown;
                        name: root.tourney-right-name;
                        meta: root.tourney-right-meta;
                        pan(dx, dy) => { root.tourney-pan(dx, dy); }
                        zoom-at(d, fx, fy) => { root.tourney-zoom(d, fx, fy); }
                    }
                }

                TourneyStrip {
                    height: 92px;
                    cards: root.tourney-group;
                }

                Rectangle {
                    height: 30px;
                    background: Theme.card-bg;
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;

                        Text {
                            text: "session \{root.tourney-round} / \{root.tourney-rounds}  ·  round \{root.tourney-session-round}, \{root.tourney-alive} still in  ·  \{root.tourney-done} / \{root.tourney-total} decided";
                            color: Theme.dim-fg;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                        Text {
                            text: root.tourney-can-undo
                                ? "1  left      2  right      3  both      k  keep the rest      u  undo      → skip session      scroll  zoom      0  fit"
                                : "1  left      2  right      3  both      k  keep the rest      → skip session      scroll  zoom      0  fit";
                            color: Theme.dim-fg;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        Text {
                            text: root.tourney-zoom-level > 1.01
                                ? "\{Math.round(root.tourney-zoom-level * 10) / 10}×"
                                : "fit";
                            color: Theme.dim-fg;
                            font-size: 12px;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            if root.in-browser && !root.grid-open && !root.tourney-active: HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0;

                VerticalLayout {
                    horizontal-stretch: 1;

                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.photo-surface;
                        clip: true;

                        if root.preview-loading: Text {
                            text: "Loading…";
                            color: Theme.dim-fg;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        if !root.preview-loading: Image {
                            source: root.preview-photo;
                            image-fit: contain;
                            width: 100%;
                            height: 100%;
                        }

                        // The same surface the tournament's panes use, on
                        // the photo area alone rather than the whole
                        // column: this is the rectangle the crop is cut
                        // to, so it is the one whose size Rust needs.
                        ZoomSurface {
                            pan(dx, dy) => { root.preview-pan(dx, dy); }
                            zoom-at(d, fx, fy) => { root.preview-zoom(d, fx, fy); }
                            resized(w, h) => { root.preview-view(w, h); }
                        }
                    }

                    Rectangle {
                        height: 36px;
                        background: Theme.sidebar-bg;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 6px;
                            FlatButton {
                                text: "‹";
                                clicked => { root.nav-prev(); }
                            }
                            if root.preview-state > 0: Rectangle {
                                border-radius: 10px;
                                background: root.preview-state == 1
                                    ? Theme.marked.with-alpha(0.18)
                                    : (root.preview-state == 2
                                        ? Theme.rejected.with-alpha(0.18)
                                        : Theme.success.with-alpha(0.18));
                                HorizontalLayout {
                                    padding-left: 9px;
                                    padding-right: 9px;
                                    Text {
                                        text: root.preview-state == 1
                                            ? "● marked for import"
                                            : (root.preview-state == 2
                                                ? "× not imported"
                                                : "✓ already in library");
                                        color: root.preview-state == 1
                                            ? Theme.marked
                                            : (root.preview-state == 2
                                                ? Theme.rejected
                                                : Theme.success);
                                        font-size: 11px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            Text {
                                text: root.preview-filename;
                                color: Theme.fg;
                                font-size: 13px;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                horizontal-alignment: center;
                                overflow: elide;
                            }
                            FlatButton {
                                text: "›";
                                clicked => { root.nav-next(); }
                            }
                            FlatButton {
                                text: "↺";
                                enabled: !root.rotating;
                                clicked => { root.rotate(false); }
                            }
                            FlatButton {
                                text: "↻";
                                enabled: !root.rotating;
                                clicked => { root.rotate(true); }
                            }
                            // Said only while there is something to say:
                            // at fit the photo is simply the photo, and a
                            // permanent "1×" would be one more thing on
                            // screen meaning nothing. `0` puts it back.
                            if root.preview-zoom-level > 1.01: Text {
                                text: "\{Math.round(root.preview-zoom-level * 10) / 10}×";
                                color: Theme.dim-fg;
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Rectangle {
                    width: 1px;
                    background: Theme.separator-color;
                }

                VerticalLayout {
                    width: 280px;

                    ImportGridView {
                        vertical-stretch: 1;
                        items: root.items;
                        current-index: root.current-index;
                        current-row: root.current-row;
                        cell-size: 236px;
                        clicked(i) => { root.item-clicked(i); }
                        window-changed(a, b, c) => { root.preview-window(a, b, c); }
                    }

                    Rectangle {
                        height: 28px;
                        background: Theme.card-bg;

                        if root.scanning: HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;

                            ProgressBar {
                                vertical-stretch: 0;
                                y: (parent.height - self.height) / 2;
                                horizontal-stretch: 1;
                                value: root.total-count > 0
                                    ? root.scanned-count * 1.0 / root.total-count
                                    : 0;
                            }
                            Text {
                                text: root.total-count > 0
                                    ? "Scanning: \{root.scanned-count} / \{root.total-count}"
                                    : "Scanning…";
                                color: Theme.dim-fg;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                        }

                        if !root.scanning: Text {
                            text: root.status-text;
                            color: Theme.dim-fg;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // ── The brush, floating over the preview ──────────────────
        //
        // Deliberately not a modal, and deliberately without a TouchArea of
        // its own: a bare Rectangle does not intercept pointer events in
        // Slint, so clicks land on the preview underneath and triage carries
        // on around it. Only the × on a chip takes a click.
        //
        // Always present in the browser rather than only when tags are set —
        // the brush is invisible state that silently changes what an import
        // writes, so "none" needs saying as loudly as a name does, and it is
        // where both hotkeys are advertised.
        if root.in-browser: Rectangle {
            x: 16px;
            y: parent.height - self.height - 44px;
            width: 194px;
            height: 26px + Math.max(root.tags.length, 1) * 24px + 12px;
            background: Theme.card-bg;
            border-radius: Theme.radius-card;
            border-width: 1px;
            border-color: Theme.separator-color;
            drop-shadow-blur: 18px;
            drop-shadow-offset-y: 4px;
            drop-shadow-color: Theme.dark ? #00000070 : #00000024;

            VerticalLayout {
                padding: 8px;
                spacing: 2px;

                Text {
                    text: "IMPORT TAGS  ·  S ADD  ·  C CLEAR";
                    color: Theme.dim-fg;
                    font-size: 9px;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    height: 16px;
                    overflow: elide;
                }

                if root.tags.length == 0: Text {
                    text: "none — imports stay untagged";
                    color: Theme.dim-fg;
                    font-size: 11px;
                    height: 24px;
                    vertical-alignment: center;
                    overflow: elide;
                }

                for t in root.tags: Rectangle {
                    height: 24px;

                    HorizontalLayout {
                        spacing: 6px;

                        Rectangle {
                            width: 9px;
                            Rectangle {
                                width: 9px;
                                height: 9px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 4.5px;
                                background: t.color;
                            }
                        }
                        Text {
                            text: t.name;
                            color: Theme.fg;
                            font-size: 12px;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                        chip-x := TouchArea {
                            width: 18px;
                            Text {
                                // U+00D7, not U+2715. The Dingbats X renders
                                // as tofu in the default macOS UI font even
                                // though the check mark beside it (U+2713)
                                // does not; the Latin-1 multiplication sign
                                // is in every font that can draw the label.
                                text: "×";
                                color: chip-x.has-hover ? Theme.fg : Theme.dim-fg;
                                font-size: 10px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            clicked => { root.tag-toggled(t.id); }
                        }
                    }
                }
            }
        }

        // ── Tag picker (S) ────────────────────────────────────────
        //
        // This one *is* modal: it owns the keyboard while it is open (the
        // triage hotkeys stand down for it), and a name being typed should
        // not also be marking photos.
        if root.tag-picker-open: Rectangle {
            x: 0;
            y: 0;
            width: 100%;
            height: 100%;
            background: #000000.with-alpha(0.45);

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.close-tag-picker(); }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 340px;
                height: 400px;
                background: Theme.card-bg;
                border-radius: Theme.radius-card;
                border-width: 1px;
                border-color: Theme.separator-color;
                drop-shadow-blur: 32px;
                drop-shadow-offset-y: 8px;
                drop-shadow-color: Theme.dark ? #00000070 : #00000028;
                clip: true;

                // Absorb pointer events, or a click on the card reaches the
                // backdrop behind it and closes the picker.
                TouchArea { width: 100%; height: 100%; }

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    Text {
                        text: "Tag photos as…";
                        color: Theme.fg;
                        font-size: 15px;
                        font-weight: 700;
                        height: 20px;
                    }
                    Text {
                        text: "Applies to every photo you mark from now on. Photos already marked keep the tags they were marked with.";
                        color: Theme.dim-fg;
                        font-size: 11px;
                        wrap: word-wrap;
                    }

                    name-field := LineEdit {
                        placeholder-text: "New tag name…";
                        // The picker is opened from the keyboard, so it has
                        // to be typeable without reaching for the mouse:
                        // S, type, Enter.
                        init => { name-field.focus(); }
                        accepted(t) => {
                            if t != "" {
                                root.tag-created(t);
                                name-field.text = "";
                            }
                        }
                    }

                    if root.tag-choices.length == 0: Text {
                        text: "No tags yet — type a name above and press Enter.";
                        color: Theme.dim-fg;
                        font-size: 11px;
                        vertical-stretch: 1;
                        wrap: word-wrap;
                    }

                    if root.tag-choices.length > 0: choices := ScrollView {
                        vertical-stretch: 1;
                        viewport-width: choices.visible-width;
                        viewport-height: root.tag-choices.length * 30px;

                        for t[i] in root.tag-choices: Rectangle {
                            y: i * 30px;
                            width: 100%;
                            height: 28px;
                            border-radius: 6px;
                            background: row-ta.has-hover ? Theme.card-bg-hover : transparent;

                            row-ta := TouchArea {
                                clicked => { root.tag-toggled(t.id); }
                            }

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;

                                Rectangle {
                                    width: 9px;
                                    Rectangle {
                                        width: 9px;
                                        height: 9px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 4.5px;
                                        background: t.color;
                                    }
                                }
                                Text {
                                    text: t.name;
                                    color: Theme.fg;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                Text {
                                    text: t.chosen ? "✓" : "";
                                    color: Theme.accent;
                                    font-size: 13px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        height: 30px;
                        spacing: 8px;

                        FlatButton {
                            text: "Clear all";
                            enabled: root.tags.length > 0;
                            clicked => { root.clear-tags(); }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        FlatButton {
                            text: "Done";
                            clicked => { root.close-tag-picker(); }
                        }
                    }
                }
            }
        }
    }
}

// ── Embedded import source-picker (sidebar-shell design) ──────────
//
// Shown as a page inside AppWindow.  Lets the user pick a source folder
// (browse or choose a favourite / recent) then fires import-start-scan
// via the top-bar "Start Scan" button.

component FolderIcon inherits Path {
    in property <color> clr: Theme.ink-2;
    in property <length> sz: 20px;
    width: root.sz;
    height: root.sz;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.clr;
    commands: "M3 7Q3 5 5 5H9L11 7.2H19Q21 7.2 21 9.2V19Q21 21 19 21H5Q3 21 3 19Z";
}

component SectionLabel inherits Text {
    color: Theme.ink-3;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.7px;
}

component LocationRow inherits Rectangle {
    in property <ImportLocation> loc;
    callback selected;
    callback star-clicked;

    height: 50px;
    background: root.loc.is-selected ? Theme.accent-tint : transparent;
    animate background { duration: 100ms; }

    // row-ta declared first = lowest z-index, so the star on top intercepts its area
    row-ta := TouchArea {
        clicked => { root.selected(); }
    }

    HorizontalLayout {
        padding-left: 15px;
        padding-right: 48px;  // reserve space for the absolutely-placed star
        spacing: 13px;
        alignment: start;

        Rectangle {
            horizontal-stretch: 0;
            width: 20px;
            FolderIcon {
                clr: Theme.ink-2;
                sz: 20px;
                y: (parent.height - self.height) / 2;
            }
        }

        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.loc.name;
                color: Theme.ink;
                font-size: 14px;
                font-weight: 600;
                overflow: elide;
            }
            Text {
                text: root.loc.path;
                color: Theme.ink-3;
                font-size: 12px;
                font-weight: 500;
                overflow: elide;
            }
        }

        Text {
            text: root.loc.count > 0 ? root.loc.count + "" : "";
            color: Theme.ink-3;
            font-size: 11.5px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    // Star absolutely anchored to the right edge — declared last = highest z-index,
    // so its TouchArea wins over row-ta when the user clicks the star.
    Rectangle {
        x: parent.width - 42px;
        y: (parent.height - self.height) / 2;
        width: 32px;
        height: 32px;
        border-radius: 6px;
        background: star-ta.has-hover ? Theme.border : transparent;
        Text {
            text: root.loc.is-starred ? "★" : "☆";
            color: root.loc.is-starred ? Theme.accent : Theme.ink-3;
            font-size: 15px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        star-ta := TouchArea {
            clicked => { root.star-clicked(); }
        }
    }
}

export component ImportPage inherits Rectangle {
    in property <string>           source-path:  "";
    in property <string>           source-name:  "";
    in property <int>              source-count: 0;
    in property <[ImportLocation]> favorites:    [];
    in property <[ImportLocation]> recents:      [];

    callback browse;
    callback clear;
    callback location-selected(string);
    callback star-toggled(string);

    background: Theme.bg;

    ScrollView {
        viewport-width: self.visible-width;

        VerticalLayout {
            width: min(760px, parent.visible-width - 44px);
            x: max(22px, (parent.visible-width - 760px) / 2);
            padding-top: 20px;
            padding-bottom: 40px;
            spacing: 0;
            alignment: start;

            // ── Source selector ───────────────────────────────────
            Rectangle { height: 4px; }

            // Selected state — entire card opens the folder picker
            if root.source-path != "": Rectangle {
                height: 78px;
                border-radius: Theme.radius-card;
                background: src-ta.has-hover ? Theme.field : Theme.surface;
                border-width: 1px;
                border-color: src-ta.has-hover ? Theme.accent.with-alpha(0.4) : Theme.border;
                drop-shadow-blur: 2px;
                drop-shadow-color: #00000008;
                animate background { duration: 100ms; }
                animate border-color { duration: 100ms; }

                HorizontalLayout {
                    padding: 18px;
                    spacing: 14px;
                    alignment: start;

                    // Folder icon — fills accent on hover
                    Rectangle {
                        width: 44px; height: 44px;
                        border-radius: 11px;
                        background: src-ta.has-hover ? Theme.accent : Theme.accent-tint;
                        animate background { duration: 100ms; }
                        FolderIcon {
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            clr: src-ta.has-hover ? #FFFFFF : Theme.accent-text;
                            sz: 22px;
                        }
                    }

                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        spacing: 3px;
                        Text {
                            text: root.source-name;
                            color: Theme.ink;
                            font-size: 15px;
                            font-weight: 600;
                            overflow: elide;
                        }
                        Text {
                            text: src-ta.has-hover
                                ? "Click to choose a different folder"
                                : root.source-path;
                            color: src-ta.has-hover ? Theme.accent-text : Theme.ink-3;
                            font-size: 12.5px;
                            font-weight: 500;
                            overflow: elide;
                        }
                    }

                    Text {
                        text: root.source-count > 0 ? root.source-count + " photos" : "";
                        color: Theme.ink-3;
                        font-size: 12px;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                src-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.browse(); }
                }
            }

            // Empty / browse state — entire card is clickable
            if root.source-path == "": Rectangle {
                height: 160px;
                border-radius: Theme.radius-card;
                background: card-ta.has-hover ? Theme.field : Theme.surface;
                border-width: 1.5px;
                border-color: card-ta.has-hover ? Theme.accent.with-alpha(0.4) : Theme.border;
                clip: true;
                animate background { duration: 100ms; }
                animate border-color { duration: 100ms; }

                VerticalLayout {
                    alignment: center;
                    spacing: 14px;
                    padding: 30px;

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 52px; height: 52px;
                            border-radius: 13px;
                            background: card-ta.has-hover ? Theme.accent-tint : Theme.field;
                            FolderIcon {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                clr: card-ta.has-hover ? Theme.accent-text : Theme.ink-2;
                                sz: 26px;
                            }
                        }
                    }

                    Text {
                        text: "Choose a source folder";
                        color: Theme.ink;
                        font-size: 16px;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Or pick one from Favorites or Recent below";
                        color: Theme.ink-3;
                        font-size: 13.5px;
                        font-weight: 500;
                        horizontal-alignment: center;
                    }

                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 130px;
                            height: 40px;
                            border-radius: Theme.radius-btn;
                            background: card-ta.has-hover ? Theme.accent.darker(0.1) : Theme.accent;
                            animate background { duration: 100ms; }
                            drop-shadow-blur: 2px;
                            drop-shadow-color: #A4422D55;
                            Text {
                                text: "Browse…";
                                color: #FFFFFF;
                                font-size: 14px;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                card-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.browse(); }
                }
            }

            // ── Favorites ─────────────────────────────────────────
            if root.favorites.length > 0: Rectangle { height: 20px; }
            if root.favorites.length > 0: SectionLabel { text: "FAVORITES"; }
            if root.favorites.length > 0: Rectangle { height: 5px; }
            if root.favorites.length > 0: Rectangle {
                height: root.favorites.length * 51px;
                border-radius: Theme.radius-card;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                VerticalLayout {
                    for loc in root.favorites: LocationRow {
                        loc: loc;
                        selected => { root.location-selected(loc.id); }
                        star-clicked => { root.star-toggled(loc.id); }
                    }
                }
            }

            // ── Recent locations ──────────────────────────────────
            Rectangle { height: 20px; }
            SectionLabel { text: "RECENT LOCATIONS"; }
            Rectangle { height: 5px; }

            if root.recents.length == 0: Rectangle {
                height: 60px;
                border-radius: Theme.radius-card;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                Text {
                    text: "No recent locations yet";
                    color: Theme.ink-3;
                    font-size: 13.5px;
                    font-weight: 500;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            if root.recents.length > 0: Rectangle {
                height: root.recents.length * 51px;
                border-radius: Theme.radius-card;
                background: Theme.surface;
                border-width: 1px;
                border-color: Theme.border;
                clip: true;

                VerticalLayout {
                    for loc in root.recents: LocationRow {
                        loc: loc;
                        selected => { root.location-selected(loc.id); }
                        star-clicked => { root.star-toggled(loc.id); }
                    }
                }
            }
        }
    }
}
