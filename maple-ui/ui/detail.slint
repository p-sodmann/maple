// Detail / lightbox window (Slint port of views/library/detail_window/*).
//
// A second top-level `Window` shown from Rust via `.show()` and held as a
// thread-local singleton (see src/detail.rs). It presents one full-resolution
// image over a dark photo surface with pointer-anchored scroll-zoom and
// drag-to-pan, prev/next navigation through the records the grid was showing,
// a toggleable one-line EXIF strip, a collection-chips bar, and a face
// detection overlay with click-to-assign and draw-new-box support.
//
// ── Zoom / pan model ──────────────────────────────────────────────
// Zoom is a `zoom` factor (1.0 = fit-to-window … 20.0); pan is the `ox`/`oy`
// offset of the `content` rectangle, which is sized to the displayed image
// but never smaller than the visible surface, so a fit-sized image stays
// centred. Zoom comes from scroll-to-zoom (pointer-anchored) and from
// trackpad/touch pinches; pan comes from dragging and is clamped so the
// image edges can't be dragged inside the surface.
//
// Deliberately NOT a `Flickable`: a Flickable handles wheel events in its
// own event filter as soon as its viewport is larger than itself, so once
// the image was zoomed in it swallowed every scroll event before the
// scroll-to-zoom TouchArea could see it, and further two-finger scrolling
// panned instead of zooming. Panning is ~10 lines here, so we do it
// ourselves and keep the gesture handling predictable.
//
// ── Face overlay ──────────────────────────────────────────────────
// Face boxes are absolutely-positioned Rectangles inside `content` (no
// per-box TouchArea — click hit-testing is done in Rust via the zoom-area's
// `clicked` callback + the geo-* properties below). This preserves
// zoom-area's scroll-event handling for all cursor positions. Draw-mode is a
// TouchArea stacked above zoom-area that captures drag gestures; it is
// invisible (and therefore non-hit-testable) when not in use.
//
// The touch areas are siblings of `content`, not children, so their
// mouse-x/-y stay in stable surface coordinates while panning; content
// coordinates — which the geo-* properties and all Rust hit-testing use —
// are mouse-x/-y minus the pan offset.

import { Theme } from "theme.slint";
import { FlatButton } from "widgets.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";

// ── Exported structs ──────────────────────────────────────────────

// One row in the image-info popup.
// is-section = true → renders as a section heading; value is ignored.
// is-toggle = true (only meaningful when is-section is also true) → the
// heading is clickable and fires toggle-all-exif().
export struct ImageInfoRow {
    label: string,
    value: string,
    is-section: bool,
    is-toggle: bool,
}

// One collection membership chip.
export struct CollectionChip {
    id: int,
    name: string,
    color: color,
}

// One face detection bounding box.  x1/y1/x2/y2 are normalised [0, 1]
// relative to the displayed image.
export struct FaceBox {
    face-id: int,
    x1: float,
    y1: float,
    x2: float,
    y2: float,
    label: string,       // person name, suggestion, or "?"
    is-assigned: bool,   // has a confirmed person_id
    is-suggestion: bool, // ArcFace-matched suggestion above threshold
}

// One person suggestion in the face-assign panel.
export struct FacePersonSuggestion {
    person-id: int,
    name: string,
    sim-text: string,   // "83%" or "" when no embedding score
}

export component DetailWindow inherits Window {
    title: "Maple — Photo";
    preferred-width: 960px;
    preferred-height: 720px;
    min-width: 480px;
    min-height: 360px;
    background: Theme.window-bg;
    default-font-size: 14px;

    // Two-way alias so Rust can sync the theme from AppWindow.
    in-out property <bool> dark <=> Theme.dark;

    // ── Data (set from Rust) ──────────────────────────────────────
    in-out property <image> photo;
    in property <int> img-w;
    in property <int> img-h;
    in property <string> filename;
    in property <bool> loading;
    in property <string> error-text;
    in property <bool> is-fullscreen;
    in property <bool> rotating: false;
    in property <[CollectionChip]> collection-chips;
    // All collections (loaded when the add-picker opens).
    in property <[CollectionChip]> available-collections;
    in-out property <bool> add-coll-panel-open: false;

    in property <[ImageInfoRow]> image-info-rows;
    in-out property <bool> image-info-open: false;

    in property <[FaceBox]> face-boxes;
    in property <bool> show-faces: false;
    in-out property <bool> face-draw-mode: false;

    in property <[FacePersonSuggestion]> face-suggestions;
    in property <int> face-panel-id: -1;
    in-out property <bool> face-panel-open: false;
    in-out property <string> face-name-entry: "";

    // ── View state ────────────────────────────────────────────────
    property <float> zoom: 1.0;
    // Pan: offset of the content rectangle inside the surface.  Never
    // positive — 0 means "top/left edge flush", the axis minimum means
    // "bottom/right edge flush" (see clamp-ox / clamp-oy).
    property <length> ox: 0;
    property <length> oy: 0;
    // Zoom/pan state captured at the start of a zoom step or pinch gesture,
    // so the anchoring maths can work from a fixed reference.
    property <float> prev-zoom: 1.0;
    property <length> prev-ox: 0;
    property <length> prev-oy: 0;

    // Drag-to-pan state (no locals in Slint callbacks).
    property <bool> pan-dragging: false;
    property <length> pan-x0: 0;
    property <length> pan-y0: 0;
    property <length> pan-ox0: 0;
    property <length> pan-oy0: 0;
    // Set once a press has moved far enough to count as a pan rather than a
    // click, so releasing it doesn't also select a face.
    property <bool> pan-moved: false;

    // Draw-mode drag state (no locals in Slint callbacks).
    property <length> draw-x0: 0;
    property <length> draw-y0: 0;
    property <length> draw-x1: 0;
    property <length> draw-y1: 0;
    // Exposed so Rust can clear it on toggle-off.
    in-out property <bool> draw-dragging: false;

    // ── Geometry exposed to Rust for face hit-testing ─────────────
    // (Rust receives length as f32 logical pixels.)
    out property <length> geo-img-left: img-left-for(root.zoom);
    out property <length> geo-img-top: img-top-for(root.zoom);
    out property <length> geo-disp-w: root.disp-w;
    out property <length> geo-disp-h: root.disp-h;

    // ── Callbacks (wired in Rust) ─────────────────────────────────
    callback prev;
    callback next;
    callback close-requested;
    callback toggle-fullscreen;
    callback open-external;
    // rotate(clockwise): true = 90° CW, false = 90° CCW.
    callback rotate(bool);
    callback remove-collection(int);
    // add-to-collection: Rust loads available-collections, opens picker panel.
    callback add-to-collection;
    // add-to-collection-confirm(id): user chose a collection from the picker.
    callback add-to-collection-confirm(int);
    // User clicked the "ALL EXIF METADATA" heading in the info panel.
    callback toggle-all-exif;

    // Face overlay callbacks
    callback toggle-faces;
    callback toggle-face-draw;
    // Fired by zoom-area.clicked; Rust does hit-testing using geo-* props.
    callback face-area-clicked(length, length);          // viewport vp-x, vp-y
    callback face-assign-name(int, string);              // face-id, name
    callback face-assign-person(int, int);               // face-id, person-id
    callback face-delete(int);                           // face-id
    // Fired when draw-ta drag ends; Rust normalises with geo-* props.
    callback face-draw-done(length, length, length, length); // vp-x0,y0,x1,y1
    callback face-panel-close;

    // ── Geometry helpers ──────────────────────────────────────────
    property <length> view-w: surface.width;
    property <length> view-h: surface.height;
    property <float> fit-scale: (root.img-w <= 0 || root.img-h <= 0)
        ? 1.0
        : min(root.view-w / (root.img-w * 1px), root.view-h / (root.img-h * 1px));
    property <length> disp-w: root.img-w * 1px * root.fit-scale * root.zoom;
    property <length> disp-h: root.img-h * 1px * root.fit-scale * root.zoom;
    property <length> vp-w: max(root.view-w, root.disp-w);
    property <length> vp-h: max(root.view-h, root.disp-h);

    pure function ppx-for(z: float) -> float { return root.fit-scale * z; }
    pure function disp-w-for(z: float) -> length {
        return root.img-w * 1px * root.fit-scale * z;
    }
    pure function disp-h-for(z: float) -> length {
        return root.img-h * 1px * root.fit-scale * z;
    }
    pure function img-left-for(z: float) -> length {
        return (max(root.view-w, disp-w-for(z)) - disp-w-for(z)) / 2;
    }
    pure function img-top-for(z: float) -> length {
        return (max(root.view-h, disp-h-for(z)) - disp-h-for(z)) / 2;
    }
    pure function anchored-ox(m: length, z0: float, z1: float, o0: length) -> length {
        return m + o0 - (img-left-for(z1)
            + (m - img-left-for(z0)) * (ppx-for(z1) / ppx-for(z0)));
    }
    pure function anchored-oy(m: length, z0: float, z1: float, o0: length) -> length {
        return m + o0 - (img-top-for(z1)
            + (m - img-top-for(z0)) * (ppx-for(z1) / ppx-for(z0)));
    }
    // A mouse wheel notch is 60px, a trackpad delivers a stream of much
    // smaller deltas — so scale the step by the delta rather than stepping
    // once per event, which would make trackpad zoom uncontrollably fast.
    pure function stepped-zoom(delta: length) -> float {
        return clamp(root.zoom * pow(1.15, delta / 60px), 1.0, 20.0);
    }
    pure function clamp-ox(v: length) -> length {
        return max(min(v, 0px), root.view-w - root.vp-w);
    }
    pure function clamp-oy(v: length) -> length {
        return max(min(v, 0px), root.view-h - root.vp-h);
    }

    // Re-pans so the image point under (mx, my) — content coordinates in the
    // *prev-* state — stays under the pointer across a zoom change.
    function anchor-view(mx: length, my: length) {
        root.ox = clamp-ox(anchored-ox(mx, root.prev-zoom, root.zoom, root.prev-ox));
        root.oy = clamp-oy(anchored-oy(my, root.prev-zoom, root.zoom, root.prev-oy));
    }

    public function reset-view() {
        root.zoom = 1.0;
        root.ox = 0;
        root.oy = 0;
    }

    init => { key-scope.focus(); }

    key-scope := FocusScope {
        width: 100%;
        height: 100%;

        key-pressed(event) => {
            if event.text == Key.Escape {
                if root.image-info-open {
                    root.image-info-open = false;
                } else if root.add-coll-panel-open {
                    root.add-coll-panel-open = false;
                } else if root.face-panel-open {
                    root.face-panel-close();
                } else if root.face-draw-mode {
                    root.face-draw-mode = false;
                    root.draw-dragging = false;
                } else {
                    root.close-requested();
                }
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.UpArrow {
                root.prev();
                return accept;
            }
            if event.text == Key.RightArrow || event.text == Key.DownArrow {
                root.next();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            width: 100%;
            height: 100%;

            // ── Header ───────────────────────────────────────────
            Rectangle {
                height: 46px;
                background: Theme.sidebar-bg;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    padding-top: 6px;
                    padding-bottom: 6px;
                    spacing: 6px;

                    FlatButton { text: "‹ Prev"; clicked => { root.prev(); } }
                    FlatButton { text: "Next ›"; clicked => { root.next(); } }
                    Rectangle {
                        horizontal-stretch: 1;
                        Text {
                            text: root.filename;
                            color: Theme.fg;
                            font-size: 14px;
                            font-weight: 600;
                            overflow: elide;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    FlatButton {
                        text: root.show-faces ? "Faces ●" : "Faces";
                        clicked => { root.toggle-faces(); }
                    }
                    FlatButton {
                        text: root.face-draw-mode ? "Stop Draw" : "Draw Face";
                        enabled: root.show-faces;
                        clicked => { root.toggle-face-draw(); }
                    }
                    FlatButton {
                        text: "↺";
                        enabled: !root.rotating;
                        clicked => { root.rotate(false); }
                    }
                    FlatButton {
                        text: "↻";
                        enabled: !root.rotating;
                        clicked => { root.rotate(true); }
                    }
                    FlatButton { text: "Open"; clicked => { root.open-external(); } }
                    FlatButton {
                        text: root.image-info-open ? "Details ●" : "Details";
                        clicked => { root.image-info-open = !root.image-info-open; }
                    }
                    FlatButton {
                        text: root.is-fullscreen ? "Windowed" : "Fullscreen";
                        clicked => { root.toggle-fullscreen(); }
                    }
                    FlatButton { text: "✕ Close"; clicked => { root.close-requested(); } }
                }
            }

            // ── Photo surface (zoom + pan + face overlay) ─────────
            surface := Rectangle {
                vertical-stretch: 1;
                clip: true;
                background: Theme.photo-surface;

                // Pinch-to-zoom.  Trackpad pinches (macOS/iOS) and two-finger
                // touchscreen pinches arrive here; every other event is
                // forwarded, so the touch areas below still get clicks and
                // scrolls.  `center` is in this element's coordinates, which
                // are the surface's, hence the `- prev-o*` to get content
                // coordinates.
                pinch := ScaleRotateGestureHandler {
                    width: 100%;
                    height: 100%;

                    started => {
                        root.prev-zoom = root.zoom;
                        root.prev-ox = root.ox;
                        root.prev-oy = root.oy;
                    }

                    updated => {
                        if root.img-w > 0 && root.img-h > 0 {
                            root.zoom = clamp(root.prev-zoom * self.scale, 1.0, 20.0);
                            root.anchor-view(
                                self.center.x - root.prev-ox,
                                self.center.y - root.prev-oy,
                            );
                        }
                    }

                    // ── Pannable content ───────────────────────────
                    // Sized to the displayed image (but never smaller than the
                    // surface, so a fit-sized image stays centred) and shifted
                    // by root.ox / root.oy — that offset *is* the pan.
                    content := Rectangle {
                        x: root.ox;
                        y: root.oy;
                        width: root.vp-w;
                        height: root.vp-h;

                        // ── Image ──────────────────────────────────
                        Image {
                            x: (root.vp-w - root.disp-w) / 2;
                            y: (root.vp-h - root.disp-h) / 2;
                            width: root.disp-w;
                            height: root.disp-h;
                            source: root.photo;
                            image-fit: fill;
                        }

                        // ── Face overlay boxes (pure visual, no TouchArea)
                        // Click hit-testing is delegated to zoom-area.clicked
                        // + Rust.  Using `visible` instead of `if ... for`
                        // (Slint does not support combining `if` and `for` in
                        // one expression).
                        for fb in root.face-boxes: Rectangle {
                            visible: root.show-faces;
                            x: img-left-for(root.zoom) + fb.x1 * root.disp-w;
                            y: img-top-for(root.zoom) + fb.y1 * root.disp-h;
                            width: max(4px, (fb.x2 - fb.x1) * root.disp-w);
                            height: max(4px, (fb.y2 - fb.y1) * root.disp-h);
                            border-width: 2px;
                            border-color: fb.is-assigned
                                ? #33d770
                                : (fb.is-suggestion ? #ffa500 : #3388ff);
                            background: fb.is-assigned
                                ? #33d77012
                                : (fb.is-suggestion ? #ffa50012 : #3388ff12);

                            // Label just below the box.  Rectangles don't clip
                            // children by default, so this is visible outside.
                            Text {
                                x: 0;
                                y: parent.height + 2px;
                                text: fb.label;
                                color: fb.is-assigned
                                    ? #33d770
                                    : (fb.is-suggestion ? #ffa500 : #3388ff);
                                font-size: clamp(10px, parent.height * 0.15, 18px);
                            }
                        }

                        // ── Live drag preview ──────────────────────
                        Rectangle {
                            visible: root.face-draw-mode && root.draw-dragging;
                            x: min(root.draw-x0, root.draw-x1);
                            y: min(root.draw-y0, root.draw-y1);
                            width: root.draw-x1 >= root.draw-x0
                                ? root.draw-x1 - root.draw-x0
                                : root.draw-x0 - root.draw-x1;
                            height: root.draw-y1 >= root.draw-y0
                                ? root.draw-y1 - root.draw-y0
                                : root.draw-y0 - root.draw-y1;
                            border-width: 2px;
                            border-color: white.with-alpha(0.9);
                            background: transparent;
                        }
                    }

                    // ── Scroll-to-zoom + drag-to-pan + face-click area ─
                    // Deliberately a sibling of `content` rather than a child:
                    // it must not move with the pan, so that its mouse-x/-y
                    // stay in stable surface coordinates.  Content coordinates
                    // (what Rust's hit-testing and the geo-* properties use)
                    // are mouse-x/-y minus the pan offset.
                    zoom-area := TouchArea {
                        width: 100%;
                        height: 100%;
                        mouse-cursor: root.zoom <= 1.0
                            ? MouseCursor.default
                            : (root.pan-dragging ? MouseCursor.grabbing : MouseCursor.grab);

                        scroll-event(event) => {
                            if root.img-w <= 0 || root.img-h <= 0 { return accept; }
                            root.prev-zoom = root.zoom;
                            root.prev-ox = root.ox;
                            root.prev-oy = root.oy;
                            root.zoom = stepped-zoom(event.delta-y);
                            root.anchor-view(
                                self.mouse-x - root.prev-ox,
                                self.mouse-y - root.prev-oy,
                            );
                            return accept;
                        }

                        // Drag-to-pan, only meaningful once zoomed in.
                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down {
                                root.pan-x0 = self.mouse-x;
                                root.pan-y0 = self.mouse-y;
                                root.pan-ox0 = root.ox;
                                root.pan-oy0 = root.oy;
                                root.pan-dragging = root.zoom > 1.0;
                                root.pan-moved = false;
                            } else if e.kind == PointerEventKind.up
                                || e.kind == PointerEventKind.cancel {
                                root.pan-dragging = false;
                            }
                        }

                        moved => {
                            if root.pan-dragging {
                                if abs(self.mouse-x - root.pan-x0) > 3px
                                    || abs(self.mouse-y - root.pan-y0) > 3px {
                                    root.pan-moved = true;
                                }
                                root.ox = clamp-ox(root.pan-ox0 + self.mouse-x - root.pan-x0);
                                root.oy = clamp-oy(root.pan-oy0 + self.mouse-y - root.pan-y0);
                            }
                        }

                        // Delegate face hit-testing to Rust; Rust checks
                        // show-faces / face-draw-mode and the geo-* geometry.
                        // A drag that panned the image isn't a click on a face.
                        clicked => {
                            if !root.pan-moved {
                                root.face-area-clicked(
                                    self.mouse-x - root.ox,
                                    self.mouse-y - root.oy,
                                );
                            }
                        }

                        double-clicked => { root.reset-view(); }
                    }

                    // ── Draw-mode drag area ────────────────────────
                    // Stacked ABOVE zoom-area; visible (and hit-testable) only
                    // in draw mode.  Captures the drag gesture for a new bbox;
                    // scroll-zoom and drag-to-pan are blocked for the brief
                    // draw-mode session.
                    draw-ta := TouchArea {
                        visible: root.show-faces && root.face-draw-mode;
                        width: 100%;
                        height: 100%;

                        pointer-event(e) => {
                            if e.kind == PointerEventKind.down {
                                root.draw-x0 = self.mouse-x - root.ox;
                                root.draw-y0 = self.mouse-y - root.oy;
                                root.draw-x1 = root.draw-x0;
                                root.draw-y1 = root.draw-y0;
                                root.draw-dragging = true;
                            } else if e.kind == PointerEventKind.up {
                                if root.draw-dragging {
                                    root.draw-dragging = false;
                                    root.face-draw-done(
                                        root.draw-x0, root.draw-y0,
                                        self.mouse-x - root.ox,
                                        self.mouse-y - root.oy,
                                    );
                                    root.face-draw-mode = false;
                                }
                            }
                        }

                        moved => {
                            root.draw-x1 = self.mouse-x - root.ox;
                            root.draw-y1 = self.mouse-y - root.oy;
                        }
                    }
                }

                // Loading / error overlays.
                if root.loading: Rectangle {
                    Text {
                        text: "Loading…";
                        color: Theme.dim-fg;
                        font-size: 16px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                if !root.loading && root.error-text != "": Rectangle {
                    Text {
                        text: root.error-text;
                        color: #ff6b6b;
                        font-size: 14px;
                        wrap: word-wrap;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // ── Face assignment panel ─────────────────────────────
            if root.face-panel-open: Rectangle {
                height: 134px;
                background: Theme.card-bg;

                HorizontalLayout {
                    padding: 8px;
                    spacing: 8px;

                    // Suggestion list
                    VerticalLayout {
                        width: 200px;
                        spacing: 2px;

                        Text {
                            text: "Known persons:";
                            color: Theme.dim-fg;
                            font-size: 11px;
                            height: 16px;
                        }

                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                spacing: 0;
                                for sug in root.face-suggestions: sug-rect := Rectangle {
                                    height: 26px;
                                    background: sug-ta.has-hover
                                        ? Theme.card-bg-hover
                                        : transparent;
                                    border-radius: 4px;

                                    sug-ta := TouchArea {
                                        clicked => {
                                            root.face-assign-person(
                                                root.face-panel-id,
                                                sug.person-id,
                                            );
                                        }
                                    }

                                    HorizontalLayout {
                                        padding-left: 4px;
                                        padding-right: 4px;
                                        spacing: 4px;
                                        Text {
                                            text: sug.name;
                                            color: sug-ta.has-hover
                                                ? Theme.accent
                                                : Theme.fg;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                        if sug.sim-text != "": Text {
                                            text: sug.sim-text;
                                            color: Theme.dim-fg;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                if root.face-suggestions.length == 0: Text {
                                    text: "No persons yet";
                                    color: Theme.dim-fg;
                                    font-size: 12px;
                                    height: 26px;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Name entry + action buttons
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;

                        Text {
                            text: "Or enter name:";
                            color: Theme.dim-fg;
                            font-size: 11px;
                            height: 16px;
                        }

                        name-edit := LineEdit {
                            text <=> root.face-name-entry;
                            placeholder-text: "Person name…";
                            accepted(text) => {
                                root.face-assign-name(root.face-panel-id, text);
                            }
                        }

                        HorizontalLayout {
                            spacing: 4px;
                            FlatButton {
                                text: "Assign";
                                clicked => {
                                    root.face-assign-name(
                                        root.face-panel-id,
                                        root.face-name-entry,
                                    );
                                }
                            }
                            FlatButton {
                                text: "Delete";
                                clicked => { root.face-delete(root.face-panel-id); }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            FlatButton {
                                text: "Cancel";
                                clicked => { root.face-panel-close(); }
                            }
                        }
                    }
                }
            }

            // ── Add-to-collection picker panel ───────────────────
            if root.add-coll-panel-open: Rectangle {
                height: 110px;
                background: Theme.card-bg;
                VerticalLayout {
                    padding: 8px;
                    spacing: 4px;
                    HorizontalLayout {
                        Text {
                            text: "Add to collection:";
                            color: Theme.dim-fg;
                            font-size: 11px;
                            height: 16px;
                            horizontal-stretch: 1;
                        }
                        close-add-ta := TouchArea {
                            width: 20px;
                            height: 16px;
                            Text {
                                text: "✕";
                                font-size: 11px;
                                color: Theme.dim-fg;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            clicked => { root.add-coll-panel-open = false; }
                        }
                    }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 0;
                            for coll in root.available-collections: coll-pick-ta := TouchArea {
                                height: 26px;
                                Rectangle {
                                    background: coll-pick-ta.has-hover
                                        ? Theme.card-bg-hover
                                        : transparent;
                                    border-radius: 4px;
                                    HorizontalLayout {
                                        padding-left: 4px;
                                        spacing: 6px;
                                        VerticalLayout {
                                            alignment: center;
                                            Rectangle {
                                                width: 10px;
                                                height: 10px;
                                                border-radius: 5px;
                                                background: coll.color;
                                            }
                                        }
                                        Text {
                                            text: coll.name;
                                            color: coll-pick-ta.has-hover
                                                ? Theme.accent
                                                : Theme.fg;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                            overflow: elide;
                                        }
                                    }
                                }
                                clicked => {
                                    root.add-to-collection-confirm(coll.id);
                                    root.add-coll-panel-open = false;
                                }
                            }
                            if root.available-collections.length == 0: Text {
                                text: "No collections — create one in Settings.";
                                color: Theme.dim-fg;
                                font-size: 12px;
                                height: 24px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ── Image info popup (shown inline above chips/panels when open) ──
            // Handled as an absolute overlay below; placeholder keeps VerticalLayout
            // unaffected — actual popup is a sibling of this VerticalLayout.

            // ── Collection chips bar ──────────────────────────────
            Rectangle {
                height: 40px;
                background: Theme.sidebar-bg;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: start;

                    Text {
                        text: "Collections";
                        color: Theme.dim-fg;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    for chip[i] in root.collection-chips: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 24px;
                            border-radius: 12px;
                            background: Theme.card-bg;
                            HorizontalLayout {
                                spacing: 5px;
                                padding-left: 8px;
                                padding-right: 6px;
                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 10px;
                                        height: 10px;
                                        border-radius: 5px;
                                        background: chip.color;
                                    }
                                }
                                Text {
                                    text: chip.name;
                                    color: Theme.fg;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                rmv := TouchArea {
                                    width: 16px;
                                    Text {
                                        text: "✕";
                                        font-size: 11px;
                                        color: rmv.has-hover ? #ff6b6b : Theme.dim-fg;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    clicked => { root.remove-collection(chip.id); }
                                }
                            }
                        }
                    }

                    if root.collection-chips.length == 0: Text {
                        text: "None";
                        color: Theme.dim-fg;
                        font-size: 12px;
                        vertical-alignment: center;
                    }

                    add-ta := TouchArea {
                        width: 24px;
                        Text {
                            text: "+";
                            color: add-ta.has-hover ? Theme.accent : Theme.dim-fg;
                            font-size: 16px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        clicked => { root.add-to-collection(); }
                    }

                    Rectangle { horizontal-stretch: 1; }
                }
            }
        }

        // ── Image info popup overlay ──────────────────────────────────────
        // Sibling of VerticalLayout; later in document order → rendered on top.
        // Semi-transparent backdrop dims the photo; a rounded card holds the rows.
        if root.image-info-open: Rectangle {
            x: 0; y: 0;
            width: 100%;
            height: 100%;
            background: #000000.with-alpha(0.55);

            // Clicking the backdrop closes the popup.
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.image-info-open = false; }
            }

            // Centred card.
            info-card := Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: min(600px, parent.width - 48px);
                height: min(580px, parent.height - 64px);
                background: Theme.card-bg;
                border-radius: Theme.card-radius;
                drop-shadow-blur: 28px;
                drop-shadow-color: Theme.dark ? #00000088 : #00000044;
                clip: true;

                // Absorb pointer events so they don't reach the backdrop.
                TouchArea { width: 100%; height: 100%; }

                VerticalLayout {
                    spacing: 0;

                    // ── Card header ─────────────────────────────
                    Rectangle {
                        height: 50px;
                        background: Theme.sidebar-bg;
                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 10px;
                            spacing: 0;
                            Text {
                                text: "Image Details";
                                color: Theme.fg;
                                font-size: 15px;
                                font-weight: 600;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }
                            close-info := TouchArea {
                                width: 40px;
                                Text {
                                    text: "✕";
                                    color: close-info.has-hover ? Theme.fg : Theme.dim-fg;
                                    font-size: 16px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                clicked => { root.image-info-open = false; }
                            }
                        }
                    }
                    // Divider
                    Rectangle { height: 1px; background: Theme.border; }

                    // ── Scrollable key-value rows ────────────────
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            padding-top: 6px;
                            padding-bottom: 16px;
                            spacing: 0;
                            for row in root.image-info-rows: Rectangle {
                                height: row.is-section ? 36px : 26px;

                                // Section heading: accent label + underline at bottom.
                                if row.is-section: Rectangle {
                                    y: parent.height - 22px;
                                    width: 100%;
                                    height: 22px;
                                    Text {
                                        text: row.label;
                                        color: Theme.accent-text;
                                        font-size: 10px;
                                        font-weight: 700;
                                        vertical-alignment: center;
                                    }
                                }

                                // Clickable section heading (currently only "ALL EXIF METADATA").
                                if row.is-toggle: TouchArea {
                                    width: 100%;
                                    height: 100%;
                                    clicked => { root.toggle-all-exif(); }
                                }

                                // Regular row: dim label on the left, value on the right.
                                if !row.is-section: HorizontalLayout {
                                    height: parent.height;
                                    spacing: 12px;
                                    alignment: start;
                                    Text {
                                        text: row.label;
                                        color: Theme.dim-fg;
                                        font-size: 12px;
                                        width: 116px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: row.value;
                                        color: Theme.fg;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
