// Debug window — compare two images' stored embeddings by id.
//
// Reuses the DINOv2 embeddings already computed by the background hasher for
// stack detection (see maple-db's `similarity_for_images`); this is a lookup
// against `image_hashes`, not a fresh inference pass.
import { Theme } from "theme.slint";
import { LineEdit } from "std-widgets.slint";
import { FlatButton } from "widgets.slint";

export component DebugCompareWindow inherits Window {
    title: "Maple — Compare Embeddings";
    preferred-width: 420px;
    preferred-height: 300px;
    min-width: 360px;
    min-height: 260px;
    background: Theme.bg;
    default-font-size: 14px;

    // Two-way alias so Rust can sync the theme from AppWindow.
    in-out property <bool> dark <=> Theme.dark;

    in-out property <string> image-id-a: "";
    in-out property <string> image-id-b: "";
    in property <string> result-text: "";
    in property <bool> result-is-error: false;

    callback close-requested;
    callback compare;

    init => { key-scope.focus(); }

    key-scope := FocusScope {
        width: 100%; height: 100%;

        key-pressed(event) => {
            if event.text == Key.Escape {
                root.close-requested();
                return accept;
            }
            if event.text == Key.Return {
                root.compare();
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            // ── Header ───────────────────────────────────────────
            Rectangle {
                height: 56px;
                background: Theme.bg;

                Rectangle {
                    x: 0; y: parent.height - 1px;
                    width: parent.width; height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: 22px;
                    padding-right: 14px;
                    spacing: 10px;
                    Text {
                        text: "Compare Embeddings";
                        color: Theme.ink;
                        font-size: 17px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: 32px; height: 32px;
                        horizontal-stretch: 0;
                        border-radius: 8px;
                        background: close-ta.has-hover ? Theme.border.with-alpha(0.7) : transparent;
                        y: (parent.height - self.height) / 2;
                        animate background { duration: 100ms; }
                        Path {
                            width: 12px; height: 12px;
                            x: (parent.width  - self.width)  / 2;
                            y: (parent.height - self.height) / 2;
                            viewbox-width: 24; viewbox-height: 24;
                            fill: transparent;
                            stroke: Theme.ink-2;
                            stroke-width: 2.2px;
                            commands: "M6 6L18 18M18 6L6 18";
                        }
                        close-ta := TouchArea { clicked => { root.close-requested(); } }
                    }
                }
            }

            // ── Body ─────────────────────────────────────────────
            VerticalLayout {
                padding: 20px;
                spacing: 16px;

                Text {
                    text: "Compares stored embeddings for two images by id. Both images must already have a stack-detection embedding.";
                    color: Theme.ink-2;
                    font-size: 12px;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: "Image ID A"; color: Theme.ink-3; font-size: 11px; font-weight: 600; }
                        LineEdit {
                            text <=> root.image-id-a;
                            input-type: number;
                            placeholder-text: "e.g. 12";
                        }
                    }
                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;
                        Text { text: "Image ID B"; color: Theme.ink-3; font-size: 11px; font-weight: 600; }
                        LineEdit {
                            text <=> root.image-id-b;
                            input-type: number;
                            placeholder-text: "e.g. 34";
                        }
                    }
                }

                FlatButton {
                    text: "Compare";
                    clicked => { root.compare(); }
                }

                if root.result-text != "": Text {
                    text: root.result-text;
                    color: root.result-is-error ? #e74c3c : Theme.accent;
                    font-size: 13px;
                    wrap: word-wrap;
                }

                Rectangle { vertical-stretch: 1; }
            }
        }
    }
}
