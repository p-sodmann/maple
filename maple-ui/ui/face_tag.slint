// Dedicated face-tagging window.
//
// Shows one untagged face at a time as a square crop centred on the bounding
// box, padded by one bbox-diameter in every direction (grey-filled where the
// image doesn't reach).  The assignment panel is always visible; any action
// (Assign / Delete / Skip) automatically advances to the next face.

import { Theme } from "theme.slint";
import { FlatButton } from "widgets.slint";
import { LineEdit, ScrollView } from "std-widgets.slint";
import { FacePersonSuggestion } from "detail.slint";

export component FaceTagWindow inherits Window {
    title: "Maple — Tag Faces";
    preferred-width: 480px;
    preferred-height: 720px;
    min-width: 360px;
    min-height: 500px;
    background: Theme.window-bg;
    default-font-size: 14px;

    // ── Data ──────────────────────────────────────────────────────────
    in-out property <image> face-crop;
    in property <bool> loading: false;
    in property <string> progress-text: "";
    in property <int> face-panel-id: -1;
    in property <[FacePersonSuggestion]> face-suggestions;
    in-out property <string> face-name-entry: "";

    // ── Callbacks ─────────────────────────────────────────────────────
    callback back;
    callback prev-face;
    callback next-face;
    callback face-assign-name(int, string);
    callback face-assign-person(int, int);
    callback face-delete(int);
    callback face-skip(int);

    VerticalLayout {
        // ── Header ────────────────────────────────────────────────────
        Rectangle {
            height: 46px;
            background: Theme.sidebar-bg;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                padding-top: 6px;
                padding-bottom: 6px;
                spacing: 6px;

                FlatButton { text: "← Back"; clicked => { root.back(); } }
                FlatButton { text: "‹ Prev"; clicked => { root.prev-face(); } }
                Rectangle {
                    horizontal-stretch: 1;
                    Text {
                        text: root.progress-text;
                        color: Theme.fg;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                FlatButton { text: "Next ›"; clicked => { root.next-face(); } }
            }
        }

        // ── Face crop (square, fills window width) ────────────────────
        img-area := Rectangle {
            // Square: height tracks width, capped so the panel always fits.
            height: min(self.width, 520px);
            background: Theme.photo-surface;

            if root.loading: Text {
                text: "Loading…";
                color: Theme.dim-fg;
                font-size: 14px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if !root.loading: Image {
                source: root.face-crop;
                width: 100%;
                height: 100%;
                image-fit: contain;
            }
        }

        // ── Assignment panel (always visible) ─────────────────────────
        Rectangle {
            vertical-stretch: 1;
            background: Theme.card-bg;

            HorizontalLayout {
                padding: 8px;
                spacing: 8px;

                // Left: suggestion list
                VerticalLayout {
                    width: 200px;
                    spacing: 2px;

                    Text {
                        text: "Known persons:";
                        color: Theme.dim-fg;
                        font-size: 11px;
                        height: 16px;
                    }

                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout {
                            spacing: 0;
                            for sug in root.face-suggestions: sug-rect := Rectangle {
                                height: 26px;
                                background: sug-ta.has-hover
                                    ? Theme.card-bg-hover
                                    : transparent;
                                border-radius: 4px;

                                sug-ta := TouchArea {
                                    clicked => {
                                        root.face-assign-person(
                                            root.face-panel-id,
                                            sug.person-id,
                                        );
                                    }
                                }

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    spacing: 4px;
                                    Text {
                                        text: sug.name;
                                        color: sug-ta.has-hover
                                            ? Theme.accent
                                            : Theme.fg;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    if sug.sim-text != "": Text {
                                        text: sug.sim-text;
                                        color: Theme.dim-fg;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            if root.face-suggestions.length == 0: Text {
                                text: "No persons yet";
                                color: Theme.dim-fg;
                                font-size: 12px;
                                height: 26px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Right: name entry + action buttons
                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 6px;

                    Text {
                        text: "Or enter name:";
                        color: Theme.dim-fg;
                        font-size: 11px;
                        height: 16px;
                    }

                    name-edit := LineEdit {
                        text <=> root.face-name-entry;
                        placeholder-text: "Person name…";
                        accepted(text) => {
                            root.face-assign-name(root.face-panel-id, text);
                        }
                    }

                    HorizontalLayout {
                        spacing: 4px;
                        FlatButton {
                            text: "Assign";
                            clicked => {
                                root.face-assign-name(
                                    root.face-panel-id,
                                    root.face-name-entry,
                                );
                            }
                        }
                        FlatButton {
                            text: "Skip";
                            clicked => { root.face-skip(root.face-panel-id); }
                        }
                        FlatButton {
                            text: "Delete";
                            clicked => { root.face-delete(root.face-panel-id); }
                        }
                    }
                }
            }
        }
    }
}
