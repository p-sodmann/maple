// Maple — AppWindow with persistent sidebar navigation.
//
// Layout: 228 px sidebar + flexible main column.
// The sidebar holds nav items; the main column has a 62 px top-bar and the
// active view below it.  Navigation state lives entirely in the UI.
import { Theme } from "theme.slint";
import { LibraryPage, LibraryGridView, ThumbItem, DateGroup } from "library.slint";
import { ImportPage, ImportLocation } from "import.slint";
import { DetailWindow, CollectionChip, FaceBox, FacePersonSuggestion } from "detail.slint";
import { ImportWindow, ImportItem } from "import.slint";
import { SettingsWindow, SyncPeerItem } from "settings.slint";
import { CollectionsWindow, CollectionEntry, CollectionsPage, CollectionGalleryItem } from "collections.slint";
import { FaceTagWindow } from "face_tag.slint";
import { PeoplePage, PersonItem } from "people.slint";
import { DebugCompareWindow } from "debug_compare.slint";
import { PathTemplateWindow } from "path_template.slint";

// Re-export second-window types so Rust can build & show them.
export { ThumbItem, DateGroup, DetailWindow, CollectionChip, FaceBox, FacePersonSuggestion,
         ImportWindow, ImportItem, SettingsWindow, CollectionsWindow, CollectionEntry,
         FaceTagWindow, ImportLocation, PersonItem, DebugCompareWindow, PathTemplateWindow,
         SyncPeerItem }

export enum Page { library, import, people, collections }

// ── Sidebar nav item ───────────────────────────────────────────────

component NavItem inherits Rectangle {
    in property <bool> active;
    in property <string> label;
    // Icon slot: place any element as @children.
    callback clicked;

    height: 38px;
    border-radius: Theme.radius-btn;
    background: root.active
        ? Theme.surface
        : (ta.has-hover ? Theme.border.with-alpha(0.5) : transparent);
    animate background { duration: 100ms; }

    // Active-item drop shadow (subtle lift).
    drop-shadow-blur:   root.active ? 2px : 0px;
    drop-shadow-offset-y: root.active ? 1px : 0px;
    drop-shadow-color:  #00000010;

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 11px;
        alignment: start;

        @children

        Text {
            text: root.label;
            color: root.active ? Theme.accent-text : Theme.ink-2;
            font-size: 14px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// ── Four-square grid icon (Library) ───────────────────────────────

component GridIcon inherits Rectangle {
    in property <color> clr;
    width: 18px;
    height: 18px;
    Rectangle { x: 0;    y: 0;    width: 7.5px; height: 7.5px; border-radius: 1.5px; background: root.clr; }
    Rectangle { x: 10.5px; y: 0;  width: 7.5px; height: 7.5px; border-radius: 1.5px; background: root.clr; }
    Rectangle { x: 0;    y: 10.5px; width: 7.5px; height: 7.5px; border-radius: 1.5px; background: root.clr; }
    Rectangle { x: 10.5px; y: 10.5px; width: 7.5px; height: 7.5px; border-radius: 1.5px; background: root.clr; }
}

// ── Downward-arrow icon (Import) ───────────────────────────────────

component DownArrowIcon inherits Path {
    in property <color> clr;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: root.clr;
    // Filled down-arrow body + head + base bar
    commands: "M11 3 L11 13 L8.5 13 L12 17.5 L15.5 13 L13 13 L13 3 Z M4 20 L20 20 L20 22 L4 22 Z";
}

// ── People icon (head circle + shoulders arc) ─────────────────────

component PeopleIcon inherits Rectangle {
    in property <color> clr;
    width: 18px;
    height: 18px;
    // Head
    Rectangle {
        x: 4px; y: 0;
        width: 10px; height: 10px;
        border-radius: 5px;
        background: root.clr;
    }
    // Shoulders (rounded rect)
    Rectangle {
        x: 0; y: 12px;
        width: 18px; height: 7px;
        border-radius: 3.5px;
        background: root.clr;
    }
}

// ── Stacked-pages icon (Collections) ──────────────────────────────

component CollectionsIcon inherits Rectangle {
    in property <color> clr;
    width: 18px;
    height: 18px;
    // Back page
    Rectangle {
        x: 4px; y: 0;
        width: 14px; height: 11px;
        border-radius: 2px;
        border-width: 1.5px;
        border-color: root.clr;
        background: transparent;
    }
    // Front page
    Rectangle {
        x: 0; y: 5px;
        width: 14px; height: 13px;
        border-radius: 2px;
        background: root.clr;
    }
}

// ── Collection dot ─────────────────────────────────────────────────

component CollectionDot inherits Rectangle {
    in property <color>  dot-color;
    in property <string> label;
    in property <string> count;
    in property <bool>   active: false;
    // While true, this dot acts as an "add selection here" drop target
    // instead of a navigation link — see the sidebar's select-mode wiring.
    in property <bool>   drop-target: false;
    callback clicked;

    height: 32px;
    border-radius: 8px;
    background: root.active
        ? Theme.accent-tint
        : (dot-ta.has-hover
            ? (root.drop-target ? Theme.accent.with-alpha(0.18) : Theme.border.with-alpha(0.4))
            : transparent);
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: 11px;
        padding-right: 11px;
        spacing: 10px;
        alignment: start;
        Rectangle {
            width: 9px; height: 9px;
            border-radius: 4.5px;
            background: root.dot-color;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: root.label;
            color: root.active ? Theme.accent-text : Theme.ink-2;
            font-size: 13.5px;
            font-weight: root.active ? 600 : 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Text {
            text: root.count;
            color: Theme.ink-3;
            font-size: 11px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    dot-ta := TouchArea { clicked => { root.clicked(); } }
}

// ── Mass-select toggle (sidebar, next to the collections list) ─────

component SelectToggle inherits Rectangle {
    in property <bool> active: false;
    in property <int>  count: 0;
    callback clicked;

    height: 24px;
    border-radius: 7px;
    background: root.active
        ? Theme.accent
        : (ta.has-hover ? Theme.accent : Theme.accent-tint);
    animate background { duration: 80ms; }

    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        alignment: center;
        Text {
            text: root.active
                ? (root.count > 0 ? root.count + " Selected" : "Selecting…")
                : "Add Images";
            color: root.active || ta.has-hover ? #FFFFFF : Theme.accent-text;
            font-size: 11px;
            font-weight: 700;
            vertical-alignment: center;
        }
    }

    ta := TouchArea { clicked => { root.clicked(); } }
}

// ── Top-bar toggle switch ──────────────────────────────────────────

component TopBarToggle inherits Rectangle {
    in property <string> label;
    in property <bool>   checked: false;
    callback toggled;

    height: 38px;
    border-radius: Theme.radius-btn;
    background: root.checked ? Theme.accent-tint : transparent;
    border-width: 1px;
    border-color: root.checked ? Theme.accent-tint : Theme.border;
    animate background { duration: 150ms; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 9px;
        padding-bottom: 9px;
        spacing: 8px;
        alignment: center;

        Text {
            text: root.label;
            color: root.checked ? Theme.accent-text : Theme.ink-2;
            font-size: 13.5px;
            font-weight: 600;
            vertical-alignment: center;
        }

        // Pill track
        Rectangle {
            width: 32px; height: 20px;
            border-radius: 10px;
            background: root.checked ? Theme.accent : Theme.ink-3.with-alpha(0.35);
            animate background { duration: 150ms; }

            // Thumb
            Rectangle {
                width: 16px; height: 16px;
                border-radius: 8px;
                background: #FFFFFF;
                x: root.checked ? 14px : 2px;
                y: 2px;
                animate x { duration: 150ms; easing: ease-in-out; }
                drop-shadow-blur: 2px;
                drop-shadow-offset-y: 1px;
                drop-shadow-color: #00000025;
            }
        }
    }

    TouchArea { clicked => { root.toggled(); } }
}

// ── Main window ────────────────────────────────────────────────────

// Sidebar sync indicator. Label, colour and pulse all arrive pre-computed
// from `maple_sync::SyncStatus::display()` — the mapping from state to words
// is a pure function with its own tests, and duplicating any of it here would
// give it a second, untested home.
component SyncPill inherits Rectangle {
    in property <string> label: "";
    in property <string> tooltip: "";
    in property <color>  dot-color: #8A837A;
    in property <bool>   pulsing: false;
    // Flipped once a second by the same Rust timer that refreshes the label,
    // which is what makes the dot breathe. A pure-Slint animation would need
    // its own clock.
    in property <bool>   pulse-on: false;
    callback clicked;

    height: 34px;
    border-radius: Theme.radius-btn;
    background: pill-ta.has-hover ? Theme.border.with-alpha(0.5) : transparent;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;

        Rectangle {
            width: 9px; height: 9px;
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 0;
            border-radius: 5px;
            background: root.dot-color;
            opacity: (root.pulsing && !root.pulse-on) ? 0.3 : 1.0;
            animate opacity { duration: 800ms; easing: ease-in-out; }
        }
        // Hover swaps the label for the detail rather than opening a popup:
        // the pill is a fixed 34 px either way, so nothing below it moves.
        Text {
            text: (pill-ta.has-hover && root.tooltip != "") ? root.tooltip : root.label;
            color: Theme.ink-2;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }

    pill-ta := TouchArea { clicked => { root.clicked(); } }
}

export component AppWindow inherits Window {
    title: "Maple";
    preferred-width: 1280px;
    preferred-height: 820px;
    min-width: 720px;
    min-height: 480px;
    background: Theme.bg;
    default-font-size: 14px;

    // Exposes the current dark-mode state so Rust can read it for secondary windows.
    in-out property <bool> dark <=> Theme.dark;

    // ── Navigation state ─────────────────────────────────────────
    in-out property <Page> page: Page.library;

    // ── Library ──────────────────────────────────────────────────
    in property <[ThumbItem]>  library-items;
    in property <[DateGroup]>  library-date-groups;
    // Rows the current library query matches in total. `library-items` only
    // holds the pages loaded so far (endless scrolling), so the header count
    // comes from here; -1 while the count query is still running.
    in property <int>          library-total-count: -1;
    in-out property <bool>     date-view-on: false;
    // "Hide Remote" — whether the library is showing only photos this device
    // holds. The toggle appears at all only when there is something to hide
    // (`remote-count` > 0), so a device with no peers never sees it.
    in-out property <bool>     local-only-on: false;
    in property <int>          remote-count: 0;
    in property <length>       library-cell-size: 160px;
    // Non-empty when the library grid is filtered to one person's photos
    // (set from the People page); shows "Photos of {name}" + a clear button
    // in the top bar instead of "All Photos".
    in property <string>       library-filter-name: "";

    // ── Import page state ─────────────────────────────────────────
    in property <string>           import-source-path:  "";
    in property <string>           import-source-name:  "";
    in property <int>              import-source-count: 0;
    in property <[ImportLocation]> import-favorites:    [];
    in property <[ImportLocation]> import-recents:      [];
    in-out property <bool>         import-scanning:     false;

    // ── People page ───────────────────────────────────────────────
    in property <[PersonItem]> people-items;
    in property <int>          people-untagged-count: 0;

    // ── Collections page ──────────────────────────────────────────
    in property <[CollectionEntry]> collections-list:        [];
    in-out property <int>           collections-selected-id: -1;
    in property <string>            collections-sel-name:        "";
    in property <color>             collections-sel-color:       #B5543E;
    in property <int>               collections-sel-count:       0;
    in property <string>            collections-sel-parent-name: "";
    in property <[ThumbItem]>       collections-thumbs:      [];
    in property <[CollectionGalleryItem]> collections-gallery-items: [];

    // Sidebar dots (top-level collections, shown below nav).
    in property <[CollectionEntry]> sidebar-collections: [];

    // ── Library mass-select (sidebar "Select" toggle) ──────────────
    // While true, the grid captures click/drag for selection instead of
    // opening the detail viewer, and sidebar collection dots become "add
    // selection here" targets instead of navigation links.
    in-out property <bool> library-select-mode: false;
    in property <int>      library-selected-count: 0;

    // Id of the collection the Library grid is currently filtered to, via a
    // Collections gallery card (-1 = not filtered to a single collection).
    // Highlights the matching sidebar dot and gallery card.
    in property <int> library-active-collection-id: -1;

    // ── AI / faces toggle state (library top-bar) ─────────────────
    in-out property <bool> ai-on:    false;
    in-out property <bool> faces-on: false;
    in property <string>   ai-progress:    "";   // e.g. "412 / 2 481"
    in property <string>   faces-progress: "";

    // ── Callbacks ─────────────────────────────────────────────────
    callback library-shown;
    callback library-search-changed(string);
    callback library-activated(int);
    callback library-request-more(int);
    callback library-filter-cleared;
    callback toggle-select-mode;
    callback library-marquee-select(int, int, length, length, length, length, float);
    // Sidebar dot clicked while in select-mode: make that collection the
    // "editing target" — checkboxes sync to its real membership, and every
    // tap/drag from then on live-adds/removes against it.
    callback collections-set-select-target(int);

    callback import-page-shown;
    callback import-browse;
    callback import-clear;
    callback import-location-selected(string);
    callback import-star-toggled(string);
    callback import-start-scan;

    callback people-page-shown;
    callback people-person-activated(int, string);  // person_id, name → filter library
    callback people-tag-faces;
    callback people-edit-save(int, string);
    callback people-edit-delete(int);

    callback collections-page-shown;
    callback collections-select(int);
    callback collections-create(string, color, int);
    callback collections-delete(int);
    callback collections-rename(int, string);
    callback collections-open-image(int);
    callback collections-activated(int, string);
    callback collections-edit-save(int, string, color);
    callback collections-edit-delete(int);

    callback toggle-ai;
    callback toggle-faces;
    callback toggle-date-view;
    callback toggle-local-only;
    callback detect-faces-clicked;
    callback tag-faces-clicked;

    // ── Sync status pill ──────────────────────────────────────────
    in property <string> sync-pill-label:   "Sync off";
    in property <string> sync-pill-tooltip: "";
    in property <color>  sync-pill-color:   #8A837A;
    in property <bool>   sync-pill-pulsing: false;
    in property <bool>   sync-pill-pulse-on: false;
    callback sync-pill-clicked;

    callback settings-clicked;
    callback debug-clicked;
    callback theme-toggled(bool);  // fires with new dark value so Rust can sync secondary windows

    // ── Shell layout ──────────────────────────────────────────────
    HorizontalLayout {
        spacing: 0;

        // ══ SIDEBAR ══════════════════════════════════════════════
        Rectangle {
            width: Theme.sidebar-width;
            background: Theme.sidebar;

            // Right border
            Rectangle {
                x: parent.width - 1px;
                y: 0;
                width: 1px;
                height: parent.height;
                background: Theme.border;
            }

            VerticalLayout {
                padding-top: 18px;
                padding-bottom: 18px;
                padding-left: 13px;
                padding-right: 13px;
                spacing: 2px;

                // Wordmark (logo placeholder)
                Rectangle {
                    height: 42px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-bottom: 4px;
                        spacing: 10px;
                        alignment: start;
                        Text {
                            text: "Maple";
                            color: Theme.ink;
                            font-size: 17px;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }

                // ── Primary nav ───────────────────────────────────
                NavItem {
                    active: root.page == Page.library;
                    label: "Library";
                    clicked => {
                        if (root.page != Page.library) {
                            root.page = Page.library;
                            root.library-shown();
                        }
                    }
                    GridIcon {
                        clr: root.page == Page.library ? Theme.accent-text : Theme.ink-2;
                    }
                }

                NavItem {
                    active: root.page == Page.import;
                    label: "Import";
                    clicked => {
                        if (root.page != Page.import) {
                            root.page = Page.import;
                            root.import-page-shown();
                        }
                    }
                    DownArrowIcon {
                        clr: root.page == Page.import ? Theme.accent-text : Theme.ink-2;
                    }
                }

                NavItem {
                    active: root.page == Page.people;
                    label: "People";
                    clicked => {
                        if (root.page != Page.people) {
                            root.page = Page.people;
                            root.people-page-shown();
                        }
                    }
                    PeopleIcon {
                        clr: root.page == Page.people ? Theme.accent-text : Theme.ink-2;
                    }
                }

                NavItem {
                    active: root.page == Page.collections;
                    label: "Collections";
                    clicked => {
                        if (root.page != Page.collections) {
                            root.page = Page.collections;
                            root.collections-page-shown();
                        }
                    }
                    CollectionsIcon {
                        clr: root.page == Page.collections ? Theme.accent-text : Theme.ink-2;
                    }
                }

                // ── Collections list ──────────────────────────────
                if root.sidebar-collections.length > 0: Rectangle { height: 12px; }
                if root.sidebar-collections.length > 0: HorizontalLayout {
                    height: 24px;
                    Text {
                        text: "COLLECTIONS";
                        color: Theme.ink-3;
                        font-size: 11px;
                        font-weight: 600;
                        letter-spacing: 0.7px;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    SelectToggle {
                        active: root.library-select-mode;
                        count: root.library-selected-count;
                        clicked => { root.toggle-select-mode(); }
                    }
                }
                for coll in root.sidebar-collections: CollectionDot {
                    dot-color: coll.color;
                    label: coll.name;
                    count: coll.image-count + "";
                    active: (root.page == Page.collections
                        && root.collections-selected-id == coll.id)
                        || root.library-active-collection-id == coll.id;
                    drop-target: root.library-select-mode;
                    clicked => {
                        if (root.library-select-mode) {
                            root.collections-set-select-target(coll.id);
                        } else {
                            root.page = Page.collections;
                            root.collections-selected-id = coll.id;
                            root.collections-page-shown();
                            root.collections-select(coll.id);
                        }
                    }
                }

                // ── Footer ────────────────────────────────────────
                Rectangle { vertical-stretch: 1; }

                // Above the divider, not below it: the footer row that
                // follows is the Settings button and the theme toggle, and a
                // pill placed last would sit under them rather than at the
                // bottom of the nav list where §1.3 puts it.
                SyncPill {
                    label:     root.sync-pill-label;
                    tooltip:   root.sync-pill-tooltip;
                    dot-color: root.sync-pill-color;
                    pulsing:   root.sync-pill-pulsing;
                    pulse-on:  root.sync-pill-pulse-on;
                    clicked => { root.sync-pill-clicked(); }
                }
                Rectangle { height: 6px; }

                Rectangle {
                    height: 1px;
                    background: Theme.border;
                }

                Rectangle {
                    height: 48px;
                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 4px;
                        spacing: 0;
                        alignment: space-between;

                        // Settings
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: Theme.radius-btn;
                            background: settings-ta.has-hover ? Theme.border.with-alpha(0.5) : transparent;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-top: 15px;
                                padding-bottom: 15px;
                                spacing: 8px;
                                alignment: start;
                                // Sliders icon (2 lines with circles)
                                Rectangle {
                                    width: 18px; height: 18px;
                                    Rectangle { x: 0; y: 5px; width: 18px; height: 1.5px; border-radius: 1px; background: Theme.ink-2; }
                                    Rectangle { x: 0; y: 11px; width: 18px; height: 1.5px; border-radius: 1px; background: Theme.ink-2; }
                                    Rectangle { x: 5px; y: 2.5px; width: 6px; height: 6px; border-radius: 3px; background: Theme.sidebar; border-width: 1.5px; border-color: Theme.ink-2; }
                                    Rectangle { x: 7px; y: 8.5px; width: 6px; height: 6px; border-radius: 3px; background: Theme.sidebar; border-width: 1.5px; border-color: Theme.ink-2; }
                                }
                                Text {
                                    text: "Settings";
                                    color: Theme.ink-2;
                                    font-size: 13.5px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                            settings-ta := TouchArea {
                                clicked => { root.settings-clicked(); }
                            }
                        }

                        // Light / dark toggle pill
                        Rectangle {
                            width: 58px; height: 32px;
                            border-radius: 8px;
                            background: Theme.field;
                            border-width: 1px;
                            border-color: Theme.border;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding: 3px;
                                spacing: 0;

                                // Sun tab
                                Rectangle {
                                    width: 26px; height: 24px;
                                    border-radius: 6px;
                                    background: !Theme.dark ? Theme.surface : transparent;
                                    drop-shadow-blur: !Theme.dark ? 1px : 0;
                                    drop-shadow-color: #00000010;
                                    Text {
                                        text: "☀";
                                        color: !Theme.dark ? Theme.accent-text : Theme.ink-3;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                                // Moon tab
                                Rectangle {
                                    width: 26px; height: 24px;
                                    border-radius: 6px;
                                    background: Theme.dark ? Theme.surface : transparent;
                                    Text {
                                        text: "☾";
                                        color: Theme.dark ? Theme.accent-text : Theme.ink-3;
                                        font-size: 12px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            theme-ta := TouchArea {
                                clicked => {
                                    Theme.dark = !Theme.dark;
                                    root.theme-toggled(Theme.dark);
                                }
                            }
                        }
                    }
                }
            }
        }

        // ══ MAIN COLUMN ══════════════════════════════════════════
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0;

            // ── Top bar ──────────────────────────────────────────
            Rectangle {
                height: Theme.topbar-height;
                background: Theme.bg;

                // Bottom border
                Rectangle {
                    x: 0; y: parent.height - 1px;
                    width: parent.width; height: 1px;
                    background: Theme.border;
                }

                HorizontalLayout {
                    padding-left: Theme.content-pad;
                    padding-right: Theme.content-pad;
                    spacing: 16px;

                    // Page title — library only
                    if root.page == Page.library: Rectangle {
                        height: 38px;
                        horizontal-stretch: 0;
                        y: (parent.height - self.height) / 2;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            // Clear-filter back button — only while filtered
                            // to one person's photos.
                            if root.library-filter-name != "": Rectangle {
                                width: 26px;
                                height: 26px;
                                y: (parent.height - self.height) / 2;
                                border-radius: 8px;
                                background: filter-back-ta.has-hover ? Theme.field : transparent;
                                animate background { duration: 80ms; }

                                Path {
                                    width: 12px;
                                    height: 12px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    viewbox-width: 24;
                                    viewbox-height: 24;
                                    fill: transparent;
                                    stroke: filter-back-ta.has-hover ? Theme.ink : Theme.ink-3;
                                    stroke-width: 2.4px;
                                    commands: "M16 4L8 12L16 20";
                                }

                                filter-back-ta := TouchArea {
                                    clicked => { root.library-filter-cleared(); }
                                }
                            }

                            Text {
                                text: root.library-filter-name == ""
                                    ? "All Photos"
                                    : "Photos of " + root.library-filter-name;
                                color: Theme.ink;
                                font-size: 18px;
                                font-weight: 700;
                                letter-spacing: -0.2px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: (root.library-total-count >= 0
                                    ? root.library-total-count
                                    : root.library-items.length) + " photos";
                                color: Theme.ink-3;
                                font-size: 13px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Page title — import
                    if root.page == Page.import: Rectangle {
                        horizontal-stretch: 0;
                        height: 44px;
                        y: (parent.height - self.height) / 2;
                        VerticalLayout {
                            spacing: 2px;
                            alignment: center;
                            Text {
                                text: "Import Photos";
                                color: Theme.ink;
                                font-size: 18px;
                                font-weight: 700;
                                letter-spacing: -0.2px;
                            }
                            Text {
                                text: "Choose where your photos come from";
                                color: Theme.ink-3;
                                font-size: 12px;
                                font-weight: 500;
                            }
                        }
                    }

                    // Page title — people
                    if root.page == Page.people: Rectangle {
                        height: 38px;
                        horizontal-stretch: 0;
                        y: (parent.height - self.height) / 2;
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text {
                                text: "People";
                                color: Theme.ink;
                                font-size: 18px;
                                font-weight: 700;
                                letter-spacing: -0.2px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.people-items.length + " people";
                                color: Theme.ink-3;
                                font-size: 13px;
                                font-weight: 500;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Spacer — pushes search and actions to the right
                    Rectangle { horizontal-stretch: 1; }

                    // Search field — library only
                    if root.page == Page.library: Rectangle {
                        width: 300px;
                        height: 38px;
                        horizontal-stretch: 0;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-field;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: Theme.border;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 11px;
                            padding-bottom: 11px;
                            spacing: 10px;
                            alignment: start;
                            // Magnifier icon
                            Rectangle {
                                width: 16px; height: 16px;
                                Path {
                                    width: 16px; height: 16px;
                                    viewbox-width: 24; viewbox-height: 24;
                                    fill: transparent;
                                    stroke: Theme.ink-3;
                                    stroke-width: 1.8px;
                                    commands: "M11 19A8 8 0 1 0 11 3 8 8 0 0 0 11 19Z M21 21L16.65 16.65";
                                }
                            }
                            // Input with inline placeholder overlay
                            Rectangle {
                                horizontal-stretch: 1;
                                clip: true;

                                search-ph := Text {
                                    visible: search-ti.text == "";
                                    text: "Search your library…";
                                    color: Theme.ink-3;
                                    font-size: 14px;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }

                                search-ti := TextInput {
                                    width: 100%;
                                    height: 100%;
                                    font-size: 14px;
                                    color: Theme.ink;
                                    selection-background-color: Theme.accent-tint;
                                    selection-foreground-color: Theme.accent-text;
                                    vertical-alignment: center;
                                    edited => { root.library-search-changed(self.text); }
                                }
                            }
                        }
                    }

                    // Library actions — explicit height prevents stretch so y-centering works
                    if root.page == Page.library: Rectangle {
                        height: 38px;
                        horizontal-stretch: 0;
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            TopBarToggle {
                                label: root.ai-on && root.ai-progress != "" ? "Tag with AI  " + root.ai-progress : "Tag with AI";
                                checked: root.ai-on;
                                toggled => { root.toggle-ai(); }
                            }

                            TopBarToggle {
                                label: root.faces-on && root.faces-progress != "" ? "Detect Faces  " + root.faces-progress : "Detect Faces";
                                checked: root.faces-on;
                                toggled => { root.toggle-faces(); }
                            }

                            TopBarToggle {
                                label: "By Date";
                                checked: root.date-view-on;
                                toggled => { root.toggle-date-view(); }
                            }

                            // Only shown when this library actually holds rows
                            // whose files are on another device — on a master
                            // paired with a relay servant that is every photo
                            // the servant has, and nothing here can ever fetch
                            // them.
                            if root.remote-count > 0: TopBarToggle {
                                label: "Hide Remote  " + root.remote-count;
                                checked: root.local-only-on;
                                toggled => { root.toggle-local-only(); }
                            }
                        }
                    }

                    // Import action
                    if root.page == Page.import: Rectangle {
                        height: 38px;
                        horizontal-stretch: 0;
                        border-radius: Theme.radius-btn;
                        background: root.import-source-path != ""
                            ? Theme.accent
                            : Theme.field;
                        border-width: root.import-source-path != "" ? 0 : 1px;
                        border-color: Theme.border;
                        y: (parent.height - self.height) / 2;
                        HorizontalLayout {
                            padding-left: 18px; padding-right: 18px;
                            alignment: center;
                            Text {
                                text: root.import-scanning ? "Scanning…" : "Start Scan";
                                color: root.import-source-path != "" ? #FFFFFF : Theme.ink-3;
                                font-size: 13.5px; font-weight: 600; vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            enabled: root.import-source-path != "" && !root.import-scanning;
                            clicked => { root.import-start-scan(); }
                        }
                    }

                    // People actions
                    if root.page == Page.people: Rectangle {
                        height: 38px;
                        horizontal-stretch: 0;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.radius-btn;
                        background: root.people-untagged-count > 0
                            ? Theme.accent
                            : Theme.field;
                        border-width: root.people-untagged-count > 0 ? 0 : 1px;
                        border-color: Theme.border;
                        HorizontalLayout {
                            padding-left: 18px; padding-right: 18px;
                            alignment: center;
                            Text {
                                text: root.people-untagged-count > 0
                                    ? "Tag Faces  ·  " + root.people-untagged-count + " left"
                                    : "Tag Faces";
                                color: root.people-untagged-count > 0 ? #FFFFFF : Theme.ink-3;
                                font-size: 13.5px; font-weight: 600; vertical-alignment: center;
                            }
                        }
                        TouchArea { clicked => { root.people-tag-faces(); } }
                    }
                }
            }

            // ── Content views ────────────────────────────────────
            if root.page == Page.library: LibraryPage {
                vertical-stretch: 1;
                items: root.library-items;
                date-groups: root.library-date-groups;
                date-view: root.date-view-on;
                cell-size: root.library-cell-size;
                select-mode: root.library-select-mode;
                search-changed(t) => { root.library-search-changed(t); }
                activated(i)      => { root.library-activated(i); }
                request-more(n)   => { root.library-request-more(n); }
                select-drag(b, c, x0, y0, x1, y1, cols) => {
                    root.library-marquee-select(b, c, x0, y0, x1, y1, cols);
                }
            }


            if root.page == Page.import: ImportPage {
                vertical-stretch: 1;
                source-path:   root.import-source-path;
                source-name:   root.import-source-name;
                source-count:  root.import-source-count;
                favorites:     root.import-favorites;
                recents:       root.import-recents;
                browse         => { root.import-browse(); }
                clear          => { root.import-clear(); }
                location-selected(id) => { root.import-location-selected(id); }
                star-toggled(id)      => { root.import-star-toggled(id); }
            }

            if root.page == Page.people: PeoplePage {
                vertical-stretch: 1;
                people: root.people-items;
                untagged-count: root.people-untagged-count;
                person-activated(id, name) => { root.people-person-activated(id, name); }
                tag-faces-clicked    => { root.people-tag-faces(); }
                person-edit-save(id, name) => { root.people-edit-save(id, name); }
                person-edit-delete(id)     => { root.people-edit-delete(id); }
            }

            if root.page == Page.collections: CollectionsPage {
                vertical-stretch: 1;
                collections: root.collections-list;
                selected-id <=> root.collections-selected-id;
                sel-name: root.collections-sel-name;
                sel-color: root.collections-sel-color;
                sel-count: root.collections-sel-count;
                sel-parent-name: root.collections-sel-parent-name;
                thumbs: root.collections-thumbs;
                gallery-items: root.collections-gallery-items;
                active-collection-id: root.library-active-collection-id;
                collection-selected(id) => { root.collections-select(id); }
                create-collection(name, color, pid) => { root.collections-create(name, color, pid); }
                delete-collection(id) => { root.collections-delete(id); }
                rename-collection(id, name) => { root.collections-rename(id, name); }
                open-image(id) => { root.collections-open-image(id); }
                collection-activated(id, name) => { root.collections-activated(id, name); }
                collection-edit-save(id, name, color) => { root.collections-edit-save(id, name, color); }
                collection-edit-delete(id) => { root.collections-edit-delete(id); }
            }
        }
    }
}
